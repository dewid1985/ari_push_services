<?xml version="1.0" encoding="utf-8"?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap12/"
                  xmlns:wsam="http://www.w3.org/2007/05/addressing/metadata"
                  xmlns:wsx="http://schemas.xmlsoap.org/ws/2004/09/mex"
                  xmlns:wsap="http://schemas.xmlsoap.org/ws/2004/08/addressing/policy"
                  xmlns:msc="http://schemas.microsoft.com/ws/2005/12/wsdl/contract"
                  xmlns:wsp="http://schemas.xmlsoap.org/ws/2004/09/policy" xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                  xmlns:tns="<%= base_url %>/private.wsdl"
                  xmlns:wsa10="http://www.w3.org/2005/08/addressing"
                  xmlns:wsu="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd"
                  xmlns:wsaw="http://www.w3.org/2006/05/addressing/wsdl"
                  xmlns:wsa="http://schemas.xmlsoap.org/ws/2004/08/addressing"
                  name="ChannelConnectService"
                  targetNamespace="<%= base_url %>/private.wsdl">
    <wsdl:types>
        <xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.opentravel.org/OTA/2003/05"
                   elementFormDefault="qualified" targetNamespace="http://www.opentravel.org/OTA/2003/05">
            <xs:complexType name="OtaRequestMessage" abstract="true">
                <xs:complexContent mixed="false">
                    <xs:extension base="tns:OtaMessage"/>
                </xs:complexContent>
            </xs:complexType>
            <xs:complexType name="OtaMessage" abstract="true">
                <xs:complexContent mixed="false">
                    <xs:extension base="tns:OTA_PayloadStdAttributes">
                        <xs:sequence>
                            <xs:element minOccurs="0" maxOccurs="1" name="TPA_Extensions" type="tns:TPA_Extensions"/>
                        </xs:sequence>
                    </xs:extension>
                </xs:complexContent>
            </xs:complexType>
            <xs:complexType name="OTA_PayloadStdAttributes">
                <xs:attribute name="MessageID" type="xs:string"/>
                <xs:attribute name="EchoToken" type="xs:string"/>
                <xs:attribute name="PrimaryLangID" type="xs:string"/>
                <xs:attribute name="AltLangID" type="xs:string"/>
                <xs:attribute name="TimeStamp" type="xs:string"/>
                <xs:attribute name="Target" type="xs:string"/>
                <xs:attribute name="Version" type="xs:string"/>
                <xs:attribute name="MessageContentCode" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="TPA_Extensions">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="Image" type="xs:string"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="Security" type="tns:SecurityType"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="GuaranteeDetails" type="tns:GuaranteeDetails"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="SourceOfBusiness" type="tns:SourceOfBusiness"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="MarketSegment" type="tns:MarketSegment"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="BasicPropertyInfo" type="tns:BasicPropertyInfoType"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="Warnings" type="tns:ArrayOfWarning"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="Success" type="tns:Success"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="ResStatus" type="tns:ResStatus"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="WrittenConfInst" type="tns:WrittenConfInst"/>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="NightlyRate" type="tns:NightlyRate"/>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="DiscountedNightlyRate"
                                type="tns:DiscountedNightlyRate"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="ChildAges" type="tns:ChildAges"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="RedemptionDetail" type="tns:RedemptionDetail"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="TotalType" type="tns:TotalType"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="IsReserved" type="xs:string"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="CampaignDetails" type="tns:ArrayOfCampaignDetail"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="BaseRate" type="tns:CodeInfo"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="DerivedFormula" type="tns:AmountPercent"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="TokenInfo" type="tns:TokenInfo"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="BookingChannel" type="tns:BookingChannel"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="StaggeredCancelPolicies"
                                type="tns:ArrayOfCancelPenalty"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="BedTypes" type="tns:ArrayOfBedType"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="ItineraryTotal" type="tns:ItineraryTotal"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="RoutingCodeInfo" type="tns:RoutingCodeInfo"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="ResGuestInfo" type="tns:ResGuestInfo"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="DisclosureExclusion" type="tns:DisclosureExclusion"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="HoldPeriod" type="tns:HoldPeriod"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="AdditionalStayDetails"
                                type="tns:AdditionalStayDetails"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="VirtualCreditCardInfo"
                                type="tns:VirtualCreditCardInfoType"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="CheckInDeadline" type="tns:CheckInDeadlineType"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="TaxConfigurations" type="tns:TaxConfigurationsType"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="Orders" type="tns:ArrayOfOrder"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="OriginalAmount" type="tns:OriginalAmount"/>
                </xs:sequence>
                <xs:attribute name="NumberOfGuests" type="xs:string"/>
                <xs:attribute name="ADACompliantIndicator" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="TaxConfigurationsType">
                <xs:attribute name="PayAtProperty" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="ArrayOfOrder">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="Order" type="tns:Order"/>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="Order">
                <xs:attribute name="OrderId" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="OriginalAmount">
                <xs:attribute name="AmountBeforeTax" type="xs:string"/>
                <xs:attribute name="AmountAfterTax" type="xs:string"/>
                <xs:attribute name="Display" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="CheckInDeadlineType">
                <xs:attribute name="AbsoluteDeadline" type="xs:string"/>
                <xs:attribute name="OffsetTimeUnit" type="xs:string"/>
                <xs:attribute name="OffsetUnitMultiplier" type="xs:string"/>
                <xs:attribute name="OffsetDropTime" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="VirtualCreditCardInfoType">
                <xs:attribute name="ExpireDate" type="xs:string"/>
                <xs:attribute name="ExpirationDate" type="xs:string"/>
                <xs:attribute name="CardActivation" type="xs:string"/>
                <xs:attribute name="AuthorizationAmount" type="xs:string"/>
                <xs:attribute name="CurrencyCode" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="AdditionalStayDetails">
                <xs:attribute name="TravelPurpose" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="HoldPeriod">
                <xs:attribute name="HoursAfterBooking" type="xs:string"/>
                <xs:attribute name="DaysAfterDeparture" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="DisclosureExclusion">
                <xs:attribute name="EligibleForExclusion" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="ResGuestInfo">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="2" name="PersonName" type="tns:PersonName"/>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="Telephone" type="tns:TelephoneInfo"/>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="Email" type="tns:Email"/>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="Address" type="tns:AddressInfo"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="ContactPerson" type="tns:ContactPerson"/>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="CustLoyalty" type="tns:CustLoyalty"/>
                </xs:sequence>
                <xs:attribute name="ID" type="xs:string"/>
                <xs:attribute name="ShareAllMarketInd" type="tns:YesNo"/>
            </xs:complexType>
            <xs:complexType name="ItineraryTotal">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="1" name="Taxes" type="tns:TaxesType"/>
                </xs:sequence>
                <xs:attribute name="AmountBeforeTax" type="xs:string"/>
                <xs:attribute name="AmountAfterTax" type="xs:string"/>
                <xs:attribute name="CurrencyCode" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="SecurityType">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="1" name="LoginInfo" type="tns:LoginInfoType"/>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="LoginInfoType">
                <xs:attribute name="Username" type="xs:string"/>
                <xs:attribute name="Password" type="xs:string"/>
                <xs:attribute name="SystemType" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="GuaranteeDetails">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="1" name="PaymentCardDetails" type="tns:PaymentCardDetails"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="CertificateDetails" type="tns:CertificateDetails"/>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="PaymentCardDetails">
                <xs:attribute name="PmsCreditCardCode" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="CertificateDetails">
                <xs:attribute name="CertificateNumber" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="SourceOfBusiness">
                <xs:simpleContent>
                    <xs:extension base="xs:string">
                        <xs:attribute name="PrimaryCode" type="xs:string"/>
                        <xs:attribute name="PrimaryID" type="xs:string"/>
                        <xs:attribute name="SecondaryID" type="xs:string"/>
                        <xs:attribute name="SecondaryCode" type="xs:string"/>
                        <xs:attribute name="SubSourceID" type="xs:string"/>
                        <xs:attribute name="SubSourceCode" type="xs:string"/>
                        <xs:attribute name="MarketSourceCode" type="xs:string"/>
                        <xs:attribute name="CroCode" type="xs:string"/>
                    </xs:extension>
                </xs:simpleContent>
            </xs:complexType>
            <xs:complexType name="MarketSegment">
                <xs:simpleContent>
                    <xs:extension base="xs:string">
                        <xs:attribute name="MarketSegmentCode" type="xs:string"/>
                    </xs:extension>
                </xs:simpleContent>
            </xs:complexType>
            <xs:complexType name="BasicPropertyInfoType">
                <xs:attribute name="ChainCode" type="xs:string"/>
                <xs:attribute name="HotelCode" type="xs:string"/>
                <xs:attribute name="BrandCode" type="xs:string"/>
                <xs:attribute name="HotelCityCode" type="xs:string"/>
                <xs:attribute name="HotelName" type="xs:string"/>
                <xs:attribute name="ChainName" type="xs:string"/>
                <xs:attribute name="BrandName" type="xs:string"/>
                <xs:attribute name="AreaId" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="ArrayOfWarning">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="Warning" nillable="true" type="tns:Warning"/>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="Warning">
                <xs:simpleContent>
                    <xs:extension base="xs:string">
                        <xs:attribute name="Type" type="xs:string"/>
                        <xs:attribute name="Code" type="xs:string"/>
                        <xs:attribute name="ShortText" type="xs:string"/>
                        <xs:attribute name="Status" type="xs:string"/>
                        <xs:attribute name="RecordID" type="xs:string"/>
                    </xs:extension>
                </xs:simpleContent>
            </xs:complexType>
            <xs:complexType name="Success"/>
            <xs:complexType name="ResStatus">
                <xs:simpleContent>
                    <xs:extension base="xs:string">
                        <xs:attribute name="IsModifiable" type="xs:string" use="required"/>
                        <xs:attribute name="IsCancellable" type="xs:string"/>
                    </xs:extension>
                </xs:simpleContent>
            </xs:complexType>
            <xs:complexType name="WrittenConfInst">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="1" name="SupplementalData" type="tns:SupplementalData"/>
                </xs:sequence>
                <xs:attribute name="LanguageID" type="xs:string"/>
                <xs:attribute name="AddresseeName" type="xs:string"/>
                <xs:attribute name="Address" type="xs:string"/>
                <xs:attribute name="Telephone" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="SupplementalData">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="1" name="Text" type="tns:Text"/>
                </xs:sequence>
                <xs:attribute name="Name" type="xs:string"/>
                <xs:attribute name="ParagraphNumber" type="xs:string"/>
                <xs:attribute name="CreateDateTime" type="xs:string"/>
                <xs:attribute name="CreatorID" type="xs:string"/>
                <xs:attribute name="LastModifyDateTime" type="xs:string"/>
                <xs:attribute name="LastModifierID" type="xs:string"/>
                <xs:attribute name="Language" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="Text">
                <xs:simpleContent>
                    <xs:extension base="xs:string">
                        <xs:attribute name="Formatted" type="xs:string"/>
                        <xs:attribute name="Language" type="xs:string"/>
                        <xs:attribute name="TextFormat" type="xs:string"/>
                    </xs:extension>
                </xs:simpleContent>
            </xs:complexType>
            <xs:complexType name="NightlyRate">
                <xs:complexContent mixed="false">
                    <xs:extension base="tns:AvailabilityDayItem"/>
                </xs:complexContent>
            </xs:complexType>
            <xs:complexType name="AvailabilityDayItem">
                <xs:attribute name="Date" type="xs:string"/>
                <xs:attribute name="Price" type="xs:string"/>
                <xs:attribute name="PointsPrice" type="xs:string"/>
                <xs:attribute name="Tax" type="xs:string"/>
                <xs:attribute name="PointsTax" type="xs:string"/>
                <xs:attribute name="Fee" type="xs:string"/>
                <xs:attribute name="PointsFee" type="xs:string"/>
                <xs:attribute name="PriceWithTaxAndFee" type="xs:string"/>
                <xs:attribute name="PointsPriceWithTaxAndFee" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="DiscountedNightlyRate">
                <xs:complexContent mixed="false">
                    <xs:extension base="tns:NightlyRate">
                        <xs:attribute name="OriginalPrice" type="xs:string"/>
                        <xs:attribute name="OriginalPriceWithTaxAndFee" type="xs:string"/>
                        <xs:attribute name="Percent" type="xs:string"/>
                    </xs:extension>
                </xs:complexContent>
            </xs:complexType>
            <xs:complexType name="ChildAges">
                <xs:attribute name="Ages">
                    <xs:simpleType>
                        <xs:list itemType="xs:string"/>
                    </xs:simpleType>
                </xs:attribute>
            </xs:complexType>
            <xs:complexType name="RedemptionDetail">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="1" name="RedemptionQuantity" type="xs:string"/>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="NightlyRate" type="tns:NightlyRate"/>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="DiscountedNightlyRate"
                                type="tns:DiscountedNightlyRate"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="Base" type="tns:Base"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="Discount" type="tns:Discount"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="Fees" type="tns:ArrayOfFee"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="Taxes" type="tns:TaxesType"/>
                </xs:sequence>
                <xs:attribute name="PointsAmountBeforeTax" type="xs:string"/>
                <xs:attribute name="PointsAmountAfterTax" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="TotalType">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="1" name="Taxes" type="tns:TaxesType"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="DiscountReason" type="tns:DiscountReason"/>
                </xs:sequence>
                <xs:attribute name="TaxInclusive" type="xs:string"/>
                <xs:attribute name="AmountBeforeTax" type="xs:string"/>
                <xs:attribute name="PointsAmountBeforeTax" type="xs:string"/>
                <xs:attribute name="AmountAfterTax" type="xs:string"/>
                <xs:attribute name="PointsAmountAfterTax" type="xs:string"/>
                <xs:attribute name="CurrencyCode" type="xs:string"/>
                <xs:attribute name="DecimalPlaces" type="xs:string"/>
                <xs:attribute name="ItemRPH" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="TaxesType">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="Tax" type="tns:TaxType"/>
                </xs:sequence>
                <xs:attribute name="Amount" type="xs:string"/>
                <xs:attribute name="PointsAmount" type="xs:string" use="optional"/>
                <xs:attribute name="CurrencyCode" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="TaxType">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="TaxDescription" type="tns:ParagraphType"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="TPA_Extensions" type="tns:TPA_Extensions"/>
                </xs:sequence>
                <xs:attribute name="Amount" type="xs:string"/>
                <xs:attribute name="PointsAmount" type="xs:string"/>
                <xs:attribute name="Percent" type="xs:string"/>
                <xs:attribute name="CurrencyCode" type="xs:string"/>
                <xs:attribute name="Type" type="xs:string"/>
                <xs:attribute name="Code" type="xs:string"/>
                <xs:attribute name="EffectiveDate" type="xs:string"/>
                <xs:attribute name="ExpireDate" type="xs:string"/>
                <xs:attribute name="ChargeFrequency" type="xs:string"/>
                <xs:attribute name="ChargeUnit" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="ArrayOfFee">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="Fee" nillable="true" type="tns:Fee"/>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="Fee">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="1" name="Description" type="tns:ParagraphType"/>
                </xs:sequence>
                <xs:attribute name="TaxInclusive" type="xs:string"/>
                <xs:attribute name="Amount" type="xs:string"/>
                <xs:attribute name="PointsAmount" type="xs:string"/>
                <xs:attribute name="Code" type="xs:string"/>
                <xs:attribute name="CurrencyCode" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="ParagraphType">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="1" name="Text" type="xs:string"/>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="Image" type="xs:string"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="URL" type="xs:string"/>
                </xs:sequence>
                <xs:attribute name="Name" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="DiscountReason">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="1" name="Text" type="xs:string"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="Image" type="xs:string"/>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="Base">
                <xs:complexContent mixed="false">
                    <xs:extension base="tns:TotalType"/>
                </xs:complexContent>
            </xs:complexType>
            <xs:complexType name="ArrayOfCampaignDetail">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="CampaignDetail" type="tns:CampaignDetail"/>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="CampaignDetail">
                <xs:simpleContent>
                    <xs:extension base="xs:string">
                        <xs:attribute name="name" type="xs:string"/>
                    </xs:extension>
                </xs:simpleContent>
            </xs:complexType>
            <xs:complexType name="CodeInfo">
                <xs:attribute name="Code" type="xs:string"/>
                <xs:attribute name="BaseRateCode" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="AmountPercent">
                <xs:attribute name="NmbrOfNights" type="xs:string"/>
                <xs:attribute name="Percentage" type="xs:string"/>
                <xs:attribute name="Percent" type="xs:string"/>
                <xs:attribute name="Amount" type="xs:string"/>
                <xs:attribute name="CurrencyCode" type="xs:string"/>
                <xs:attribute name="TaxInclusive" type="xs:string"/>
                <xs:attribute name="AdjustedAmount" type="xs:string"/>
                <xs:attribute name="AdjustedPercentage" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="TokenInfo">
                <xs:attribute name="Token" type="xs:string"/>
                <xs:attribute name="TokenProviderID" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="BookingChannel">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="1" name="CompanyName" type="tns:CompanyName"/>
                </xs:sequence>
                <xs:attribute name="Primary" type="xs:string"/>
                <xs:attribute name="Type" type="xs:string"/>
                <xs:attribute name="AnyBookingChannelInd" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="CompanyName">
                <xs:simpleContent>
                    <xs:extension base="xs:string">
                        <xs:attribute name="CodeContext" type="xs:string"/>
                        <xs:attribute name="CompanyShortName" type="xs:string"/>
                        <xs:attribute name="TravelSector" type="xs:string"/>
                        <xs:attribute name="Code" type="xs:string"/>
                    </xs:extension>
                </xs:simpleContent>
            </xs:complexType>
            <xs:complexType name="ArrayOfCancelPenalty">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="StaggeredCancelPenalty"
                                type="tns:CancelPenalty"/>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="ArrayOfBedType">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="BedType" type="tns:BedType"/>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="BedType">
                <xs:attribute name="BedTypeCode" type="xs:string"/>
                <xs:attribute name="Quantity" type="xs:string" use="required"/>
            </xs:complexType>
            <xs:complexType name="CancelPenalty">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="PenaltyDescription" type="tns:ParagraphType"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="AmountPercent" type="tns:AmountPercent"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="Deadline" type="tns:Deadline"/>
                </xs:sequence>
                <xs:attribute name="PolicyCode" type="xs:string"/>
                <xs:attribute name="NonRefundable" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="Deadline">
                <xs:attribute name="AbsoluteDeadline" type="xs:string"/>
                <xs:attribute name="OffsetTimeUnit" type="tns:OffsetTimeUnit"/>
                <xs:attribute name="OffsetUnitMultiplier" type="xs:string"/>
                <xs:attribute name="OffsetDropTime" type="tns:OffsetDropTime"/>
            </xs:complexType>
            <xs:complexType name="OtaResponseMessage" abstract="true">
                <xs:complexContent mixed="false">
                    <xs:extension base="tns:OtaMessage">
                        <xs:sequence>
                            <xs:element minOccurs="0" maxOccurs="1" name="Success" type="tns:Success"/>
                            <xs:element minOccurs="0" maxOccurs="1" name="Warnings" type="tns:ArrayOfWarning"/>
                            <xs:element minOccurs="0" maxOccurs="1" name="Errors" type="tns:ArrayOfErrorType"/>
                        </xs:sequence>
                    </xs:extension>
                </xs:complexContent>
            </xs:complexType>
            <xs:complexType name="ArrayOfErrorType">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="Error" nillable="true" type="tns:ErrorType"/>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="ErrorType">
                <xs:simpleContent>
                    <xs:extension base="xs:string">
                        <xs:attribute name="Type" type="xs:string"/>
                        <xs:attribute name="Language" type="xs:string"/>
                        <xs:attribute name="ShortText" type="xs:string"/>
                        <xs:attribute name="Code" type="xs:string"/>
                        <xs:attribute name="DocURL" type="xs:string"/>
                        <xs:attribute name="Status" type="xs:string"/>
                        <xs:attribute name="Tag" type="xs:string"/>
                        <xs:attribute name="RecordID" type="xs:string"/>
                        <xs:attribute name="NodeList" type="xs:string"/>
                    </xs:extension>
                </xs:simpleContent>
            </xs:complexType>
            <xs:complexType name="PersonName">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="NamePrefix" type="xs:string"/>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="NameTitle" type="xs:string"/>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="GivenName" type="xs:string"/>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="MiddleName" type="xs:string"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="Surname" type="xs:string"/>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="NameSuffix" type="xs:string"/>
                </xs:sequence>
                <xs:attribute name="NameType" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="Name">
                <xs:complexContent mixed="false">
                    <xs:extension base="tns:PersonName"/>
                </xs:complexContent>
            </xs:complexType>
            <xs:complexType name="TelephoneInfo">
                <xs:attribute name="FormattedInd" type="xs:string"/>
                <xs:attribute name="PhoneTechType" type="xs:string"/>
                <xs:attribute name="PhoneNumber" type="xs:string"/>
                <xs:attribute name="PhoneUseType" type="xs:string"/>
                <xs:attribute name="DefaultInd" type="xs:string"/>
                <xs:attribute name="PhoneLocationType" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="Email">
                <xs:simpleContent>
                    <xs:extension base="xs:string">
                        <xs:attribute name="DefaultInd" type="xs:string"/>
                        <xs:attribute name="EmailType" type="xs:string"/>
                    </xs:extension>
                </xs:simpleContent>
            </xs:complexType>
            <xs:complexType name="AddressInfo">
                <xs:complexContent mixed="false">
                    <xs:extension base="tns:Address"/>
                </xs:complexContent>
            </xs:complexType>
            <xs:complexType name="Address">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="AddressLine" type="xs:string"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="CityName" type="xs:string"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="PostalCode" type="xs:string"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="StateProv" type="tns:StateProv"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="CountryName" type="tns:CountryName"/>
                </xs:sequence>
                <xs:attribute name="Type" type="xs:string"/>
                <xs:attribute name="Remark" type="xs:string"/>
                <xs:attribute name="CompanyName" type="xs:string"/>
                <xs:attribute name="FormattedInd" type="xs:string" use="required"/>
                <xs:attribute name="DefaultInd" type="xs:string" use="required"/>
            </xs:complexType>
            <xs:complexType name="CountryName">
                <xs:simpleContent>
                    <xs:extension base="xs:string">
                        <xs:attribute name="Code" type="xs:string"/>
                    </xs:extension>
                </xs:simpleContent>
            </xs:complexType>
            <xs:complexType name="StateProv">
                <xs:simpleContent>
                    <xs:extension base="xs:string">
                        <xs:attribute name="StateCode" type="xs:string"/>
                    </xs:extension>
                </xs:simpleContent>
            </xs:complexType>
            <xs:complexType name="CustLoyalty">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="SubAccountBalance"
                                type="tns:SubAccountBalance"/>
                </xs:sequence>
                <xs:attribute name="MembershipID" type="xs:string"/>
                <xs:attribute name="ProgramID" type="xs:string"/>
                <xs:attribute name="VendorCode" type="xs:string"/>
                <xs:attribute name="LoyalLevel" type="xs:string"/>
                <xs:attribute name="TravelSector" type="xs:string"/>
                <xs:attribute name="SignupDate" type="xs:string"/>
                <xs:attribute name="EffectiveDate" type="xs:string"/>
                <xs:attribute name="ExpireDate" type="xs:string"/>
                <xs:attribute name="PinNumber" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="SubAccountBalance">
                <xs:attribute name="Type" type="xs:string"/>
                <xs:attribute name="Balance" type="xs:int" use="required"/>
            </xs:complexType>
            <xs:complexType name="UniqueID">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="1" name="CompanyName" type="tns:CompanyName"/>
                </xs:sequence>
                <xs:attribute name="Type" type="xs:string"/>
                <xs:attribute name="ID" type="xs:string"/>
                <xs:attribute name="ID_Context" type="xs:string"/>
                <xs:attribute name="Instance" type="xs:string"/>
                <xs:attribute name="PinNumber" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="RequestorID">
                <xs:complexContent mixed="false">
                    <xs:extension base="tns:UniqueID">
                        <xs:attribute name="MessagePassword" type="xs:string"/>
                    </xs:extension>
                </xs:complexContent>
            </xs:complexType>
            <xs:complexType name="ContactPerson">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="1" name="PersonName" type="tns:PersonName"/>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="Email" type="xs:string"/>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="Telephone" type="tns:TelephoneInfo"/>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="Address" type="tns:AddressInfo"/>
                </xs:sequence>
                <xs:attribute name="ContactType" type="xs:string"/>
            </xs:complexType>
            <xs:simpleType name="YesNo">
                <xs:restriction base="xs:string">
                    <xs:enumeration value="Yes"/>
                    <xs:enumeration value="No"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:complexType name="POS">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="1" name="Source" type="tns:Source"/>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="Source">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="1" name="BookingChannel" type="tns:BookingChannel"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="RequestorId" type="tns:RequestorID"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="RequestorID" type="tns:RequestorID"/>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="Inventories">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="1" name="UniqueID" type="tns:UniqueID"/>
                    <xs:element minOccurs="1" maxOccurs="unbounded" name="Inventory" type="tns:Inventory"
                                nillable="true"/>
                </xs:sequence>
                <xs:attribute name="HotelCode" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="Inventory">
                <xs:sequence>
                    <xs:element minOccurs="1" name="StatusApplicationControl" type="tns:StatusApplicationControl"/>
                    <xs:element minOccurs="1" name="InvCounts" type="tns:InvCounts"/>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="StatusApplicationControl">
                <xs:sequence>
                    <xs:element minOccurs="1" maxOccurs="1" name="DestinationSystemCodes"
                                type="tns:DestinationSystemCodes"/>
                </xs:sequence>
                <xs:attributeGroup ref="tns:StatusApplicationGroup"/>
                <xs:attributeGroup ref="tns:DOW_PatternGroup"/>
                <xs:attributeGroup ref="tns:RatePlanCodeTypeGroup"/>
                <xs:attribute name="RateTier" type="tns:StringLength1to64" use="optional"/>
                <xs:attribute name="AllRateCode" type="xs:boolean" use="optional"/>
                <xs:attribute name="AllInvCode" type="xs:boolean" use="optional"/>
                <xs:attributeGroup ref="tns:InvBlockCodeApplyGroup"/>
                <xs:attribute name="InvBlockCode" type="tns:StringLength1to32" use="optional"/>
                <xs:attribute name="Override" type="xs:boolean" use="optional"/>
                <xs:attribute name="QuoteID" type="tns:StringLength1to32" use="optional"/>
                <xs:attribute name="SubBlockCode" type="tns:StringLength1to32" use="optional"/>
                <xs:attribute name="WingIdentifier" type="tns:StringLength1to32" use="optional"/>
            </xs:complexType>
            <xs:complexType name="DestinationSystemCodes">
                <xs:sequence>
                    <xs:element minOccurs="1" maxOccurs="unbounded" name="DestinationSystemCode"
                                type="tns:StringLength1to32"/>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="InvCounts">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="InvCount" type="tns:InvCount"/>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="InvCount">
                <xs:attribute name="CountType" type="xs:string"/>
                <xs:attribute name="Count" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="RoutingCodeInfo">
                <xs:attribute name="RoutingCode" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="Discount">
                <xs:complexContent mixed="false">
                    <xs:extension base="tns:TotalType">
                        <xs:sequence>
                            <xs:element minOccurs="0" maxOccurs="1" name="TPA_Extensions" type="tns:TPA_Extensions"/>
                        </xs:sequence>
                        <xs:attribute name="Percent" type="xs:string"/>
                    </xs:extension>
                </xs:complexContent>
            </xs:complexType>
            <xs:complexType name="UniqueID_Type">
                <xs:sequence>
                    <xs:element name="CompanyName" type="tns:CompanyNameType" minOccurs="0"/>
                </xs:sequence>
                <xs:attributeGroup ref="tns:UniqueID_Group"/>
            </xs:complexType>
            <xs:complexType name="CompanyNameType">
                <xs:annotation>
                    <xs:documentation xml:lang="en">Identifies a company by name.</xs:documentation>
                </xs:annotation>
                <xs:simpleContent>
                    <xs:extension base="tns:StringLength0to128">
                        <xs:attributeGroup ref="tns:CompanyID_AttributesGroup"/>
                        <xs:attribute name="Division" type="tns:StringLength1to32" use="optional"/>
                        <xs:attribute name="Department" type="tns:StringLength1to32" use="optional"/>
                    </xs:extension>
                </xs:simpleContent>
            </xs:complexType>
            <xs:simpleType name="OffsetTimeUnit">
                <xs:restriction base="xs:string">
                    <xs:enumeration value="Year"/>
                    <xs:enumeration value="Month"/>
                    <xs:enumeration value="Week"/>
                    <xs:enumeration value="Day"/>
                    <xs:enumeration value="Hour"/>
                    <xs:enumeration value="Second"/>
                    <xs:enumeration value="FullDuration"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:simpleType name="OffsetDropTime">
                <xs:restriction base="xs:string">
                    <xs:enumeration value="BeforeArrival"/>
                    <xs:enumeration value="AfterBooking"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:simpleType name="ListOfStringLength1to8">
                <xs:list itemType="tns:StringLength1to8"/>
            </xs:simpleType>
            <xs:simpleType name="StringLength1to8">
                <xs:restriction base="xs:string">
                    <xs:minLength value="1"/>
                    <xs:maxLength value="8"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:simpleType name="StringLength1to16">
                <xs:restriction base="xs:string">
                    <xs:minLength value="1"/>
                    <xs:maxLength value="16"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:simpleType name="StringLength1to32">
                <xs:restriction base="xs:string">
                    <xs:minLength value="1"/>
                    <xs:maxLength value="32"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:simpleType name="OTA_CodeType">
                <xs:restriction base="xs:string">
                    <xs:pattern value="[0-9A-Z]{1,3}(\.[A-Z]{3}(\.X){0,1}){0,1}"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:simpleType name="StringLength1to64">
                <xs:restriction base="xs:string">
                    <xs:minLength value="1"/>
                    <xs:maxLength value="64"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:simpleType name="DateOrTimeOrDateTimeType">
                <xs:union memberTypes="xs:date xs:dateTime xs:time"/>
            </xs:simpleType>
            <xs:simpleType name="DurationType">
                <xs:union memberTypes="xs:duration tns:NightDurationType"/>
            </xs:simpleType>
            <xs:simpleType name="NightDurationType">
                <xs:restriction base="xs:string">
                    <xs:pattern value="P[0-9]{1,3}N"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:complexType name="AvailStatusMessageType">
                <xs:sequence>
                    <xs:element name="StatusApplicationControl" type="tns:StatusApplicationControl" minOccurs="0"/>
                    <xs:element name="LengthsOfStay" type="tns:LengthsOfStayType" minOccurs="0"/>
                    <xs:element name="BestAvailableRates" minOccurs="0">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="BestAvailableRate" maxOccurs="unbounded">
                                    <xs:complexType>
                                        <xs:attribute name="LengthOfStayTime" type="xs:integer" use="optional"/>
                                        <xs:attribute name="LengthOfStayTimeUnit" type="tns:TimeUnitType"
                                                      use="optional"/>
                                        <xs:attribute name="RatePlanCode" type="tns:StringLength1to64" use="optional"/>
                                        <xs:attributeGroup ref="tns:CurrencyAmountGroup"/>
                                        <xs:attribute name="TaxInclusive" type="xs:boolean" use="optional"/>
                                    </xs:complexType>
                                </xs:element>
                            </xs:sequence>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="HurdleRate" minOccurs="0">
                        <xs:complexType>
                            <xs:attributeGroup ref="tns:CurrencyAmountGroup"/>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="Delta" minOccurs="0">
                        <xs:complexType>
                            <xs:attributeGroup ref="tns:CurrencyAmountGroup"/>
                            <xs:attribute name="Ceiling" type="xs:positiveInteger" use="optional"/>
                            <xs:attribute name="MaxSold" type="xs:positiveInteger" use="optional"/>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="UniqueID" type="tns:UniqueID_Type" minOccurs="0"/>
                    <xs:element name="RestrictionStatus" minOccurs="0">
                        <xs:complexType>
                            <xs:attributeGroup ref="tns:RestrictionStatusGroup"/>
                            <xs:attribute name="MaxAdvancedBookingOffset" type="xs:duration" use="optional"/>
                            <xs:attribute name="MinAdvancedBookingOffset" type="xs:duration" use="optional"/>
                        </xs:complexType>
                    </xs:element>
                </xs:sequence>
                <xs:attribute name="Override" type="xs:boolean" use="optional"/>
                <xs:attribute name="BookingLimitMessageType" use="optional">
                    <xs:simpleType>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="RemoveLimit"/>
                            <xs:enumeration value="SetLimit"/>
                            <xs:enumeration value="AdjustLimit"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
                <xs:attribute name="BookingLimit" type="xs:nonNegativeInteger" use="optional"/>
                <xs:attribute name="LocatorID" type="xs:positiveInteger" use="optional"/>
            </xs:complexType>
            <xs:complexType name="LengthsOfStayType">
                <xs:sequence>
                    <xs:element name="LengthOfStay" minOccurs="0" maxOccurs="unbounded">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="LOS_Pattern" minOccurs="0">
                                    <xs:complexType>
                                        <xs:attribute name="FullPatternLOS" type="tns:StringLength1to32"
                                                      use="optional"/>
                                    </xs:complexType>
                                </xs:element>
                            </xs:sequence>
                            <xs:attribute name="Time" type="xs:integer" use="optional"/>
                            <xs:attribute name="TimeUnit" type="tns:TimeUnitType" use="optional"/>
                            <xs:attribute name="OpenStatusIndicator" type="xs:boolean" use="optional"/>
                            <xs:attribute name="MinMaxMessageType" use="optional">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="SetMinLOS"/>
                                        <xs:enumeration value="RemoveMinLOS"/>
                                        <xs:enumeration value="SetMaxLOS"/>
                                        <xs:enumeration value="RemoveMaxLOS"/>
                                        <xs:enumeration value="SetForwardMinStay"/>
                                        <xs:enumeration value="RemoveForwardMinStay"/>
                                        <xs:enumeration value="SetForwardMaxStay"/>
                                        <xs:enumeration value="RemoveForwardMaxStay"/>
                                        <xs:enumeration value="FixedLOS"/>
                                        <xs:enumeration value="FullPatternLOS"/>
                                        <xs:enumeration value="MinLOS"/>
                                        <xs:enumeration value="MaxLOS"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:attribute>
                        </xs:complexType>
                    </xs:element>
                </xs:sequence>
                <xs:attribute name="ArrivalDateBased" type="xs:boolean" use="optional"/>
                <xs:attribute name="FixedPatternLength" type="tns:Numeric1to999" use="optional"/>
            </xs:complexType>
            <xs:simpleType name="TimeUnitType">
                <xs:restriction base="tns:StringLength1to16">
                    <xs:enumeration value="Year"/>
                    <xs:enumeration value="Month"/>
                    <xs:enumeration value="Week"/>
                    <xs:enumeration value="Day"/>
                    <xs:enumeration value="Hour"/>
                    <xs:enumeration value="Second"/>
                    <xs:enumeration value="FullDuration"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:simpleType name="Numeric1to999">
                <xs:restriction base="xs:integer">
                    <xs:minInclusive value="1"/>
                    <xs:maxInclusive value="999"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:simpleType name="TimeUnitType">
                <xs:restriction base="tns:StringLength1to16">
                    <xs:enumeration value="Year"/>
                    <xs:enumeration value="Month"/>
                    <xs:enumeration value="Week"/>
                    <xs:enumeration value="Day"/>
                    <xs:enumeration value="Hour"/>
                    <xs:enumeration value="Second"/>
                    <xs:enumeration value="FullDuration"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:simpleType name="AvailabilityStatusType">
                <xs:restriction base="xs:NMTOKENS">
                    <xs:enumeration value="Open"/>
                    <xs:enumeration value="Close"/>
                    <xs:enumeration value="ClosedOnArrival"/>
                    <xs:enumeration value="ClosedOnArrivalOnRequest"/>
                    <xs:enumeration value="OnRequest"/>
                    <xs:enumeration value="RemoveCloseOnly"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:simpleType name="StringLength0to128">
                <xs:restriction base="xs:string">
                    <xs:minLength value="0"/>
                    <xs:maxLength value="128"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:simpleType name="NumericStringLength1to8">
                <xs:restriction base="xs:string">
                    <xs:pattern value="[0-9]{1,8}"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:simpleType name="StringLength1to128">
                <xs:annotation>
                    <xs:documentation xml:lang="en">Used for Character Strings, length 1 to 128.</xs:documentation>
                </xs:annotation>
                <xs:restriction base="xs:string">
                    <xs:minLength value="1"/>
                    <xs:maxLength value="128"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:simpleType name="AlphaLength3">
                <xs:restriction base="xs:string">
                    <xs:pattern value="[a-zA-Z]{3}"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:simpleType name="Money">
                <xs:restriction base="xs:decimal">
                    <xs:fractionDigits value="3"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:attributeGroup name="CurrencyAmountGroup">
                <xs:attribute name="Amount" type="tns:Money" use="optional"/>
                <xs:attributeGroup ref="tns:CurrencyCodeGroup"/>
            </xs:attributeGroup>
            <xs:attributeGroup name="CurrencyCodeGroup">
                <xs:annotation>
                    <xs:documentation xml:lang="en">Provides a currency code to reflect the currency in which an amount
                        may be expressed.
                    </xs:documentation>
                </xs:annotation>
                <xs:attribute name="CurrencyCode" type="tns:AlphaLength3" use="optional"/>
                <xs:attribute name="DecimalPlaces" type="xs:nonNegativeInteger" use="optional"/>
            </xs:attributeGroup>
            <xs:attributeGroup name="InvBlockCodeApplyGroup">
                <xs:attribute name="InvBlockCodeApply" use="optional">
                    <xs:simpleType>
                        <xs:restriction base="xs:NMTOKEN">
                            <xs:enumeration value="DoesNotApply"/>
                            <xs:enumeration value="BlockCode"/>
                            <xs:enumeration value="BlockGroupingCode"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
            </xs:attributeGroup>
            <xs:attributeGroup name="RatePlanCodeTypeGroup">
                <xs:attribute name="RatePlanCodeType">
                    <xs:simpleType>
                        <xs:restriction base="xs:NMTOKEN">
                            <xs:enumeration value="DoesNotApply"/>
                            <xs:enumeration value="RatePlanCode"/>
                            <xs:enumeration value="RatePlanGroupingCode"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
            </xs:attributeGroup>
            <xs:attributeGroup name="DOW_PatternGroup">
                <xs:attribute name="Mon" type="xs:boolean" use="optional"/>
                <xs:attribute name="Tue" type="xs:boolean" use="optional"/>
                <xs:attribute name="Weds" type="xs:boolean" use="optional"/>
                <xs:attribute name="Thur" type="xs:boolean" use="optional"/>
                <xs:attribute name="Fri" type="xs:boolean" use="optional"/>
                <xs:attribute name="Sat" type="xs:boolean" use="optional"/>
                <xs:attribute name="Sun" type="xs:boolean" use="optional"/>
            </xs:attributeGroup>
            <xs:attributeGroup name="DateTimeSpanGroup">
                <xs:attribute name="Start" type="tns:DateOrTimeOrDateTimeType" use="optional"/>
                <xs:attribute name="Duration" type="tns:DurationType" use="optional"/>
                <xs:attribute name="End" type="tns:DateOrTimeOrDateTimeType" use="optional"/>
            </xs:attributeGroup>
            <xs:attributeGroup name="StatusApplicationGroup">
                <xs:attributeGroup ref="tns:DateTimeSpanGroup"/>
                <xs:attributeGroup ref="tns:RatePlanGroup"/>
                <xs:attributeGroup ref="tns:InventoryGroup"/>
            </xs:attributeGroup>
            <xs:attributeGroup name="InventoryGroup">
                <xs:attribute name="InvCodeApplication" use="optional">
                    <xs:simpleType>
                        <xs:restriction base="xs:NMTOKEN">
                            <xs:enumeration value="DoesNotApply"/>
                            <xs:enumeration value="InvCode"/>
                            <xs:enumeration value="InvGroupingCode"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
                <xs:attribute name="InvCode" type="tns:StringLength1to16" use="optional"/>
                <xs:attribute name="InvType" type="tns:StringLength1to16" use="optional"/>
                <xs:attribute name="InvTypeCode" type="tns:StringLength1to16" use="optional"/>
                <xs:attribute name="IsRoom" type="xs:boolean" use="optional"/>
            </xs:attributeGroup>
            <xs:attributeGroup name="RatePlanGroup">
                <xs:attribute name="RatePlanType" type="tns:OTA_CodeType" use="optional"/>
                <xs:attribute name="RatePlanCode" type="tns:StringLength1to64" use="optional"/>
                <xs:attribute name="RatePlanID" type="tns:StringLength1to64" use="optional"/>
                <xs:attribute name="RatePlanQualifier" type="xs:boolean" use="optional"/>
                <xs:attributeGroup ref="tns:PromotionCodeGroup"/>
                <xs:attribute name="RatePlanCategory" type="tns:StringLength1to64" use="optional"/>
            </xs:attributeGroup>
            <xs:attributeGroup name="PromotionCodeGroup">
                <xs:attribute name="PromotionCode" type="tns:StringLength1to32" use="optional"/>
                <xs:attribute name="PromotionVendorCode" type="tns:ListOfStringLength1to8" use="optional"/>
            </xs:attributeGroup>
            <xs:attributeGroup name="UniqueID_Group">
                <xs:attribute name="URL" type="xs:anyURI"/>
                <xs:attribute name="Type" type="tns:OTA_CodeType" use="required"/>
                <xs:attribute name="Instance" type="tns:StringLength1to32"/>
                <xs:attributeGroup ref="tns:ID_Group"/>
                <xs:attribute name="ID_Context" type="tns:StringLength1to32" use="optional"/>
            </xs:attributeGroup>
            <xs:attributeGroup name="ID_Group">
                <xs:attribute name="ID" type="tns:StringLength1to32" use="required"/>
            </xs:attributeGroup>
            <xs:attributeGroup name="CompanyID_AttributesGroup">
                <xs:attribute name="CompanyShortName" type="tns:StringLength1to32" use="optional"/>
                <xs:attribute name="TravelSector" type="tns:OTA_CodeType" use="optional"/>
                <xs:attribute name="Code" type="tns:StringLength1to16" use="optional"/>
                <xs:attribute name="CodeContext" type="tns:StringLength1to32" use="optional"/>
            </xs:attributeGroup>
            <xs:attributeGroup name="RestrictionStatusGroup">
                <xs:attribute name="Restriction" use="optional">
                    <xs:simpleType>
                        <xs:restriction base="xs:NMTOKENS">
                            <xs:enumeration value="Master"/>
                            <xs:enumeration value="Arrival"/>
                            <xs:enumeration value="Departure"/>
                            <xs:enumeration value="NonGuarantee"/>
                            <xs:enumeration value="TravelAgent"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
                <xs:attribute name="Status" type="tns:AvailabilityStatusType" use="optional"/>
                <xs:attribute name="SellThroughOpenIndicator" type="xs:boolean" use="optional"/>
            </xs:attributeGroup>
            <xs:attributeGroup name="HotelReferenceGroup">
                <xs:attribute name="ChainCode" type="tns:StringLength1to8" use="optional"/>
                <xs:attribute name="BrandCode" type="tns:StringLength1to8" use="optional"/>
                <xs:attribute name="HotelCode" type="tns:StringLength1to16" use="optional"/>
                <xs:attribute name="HotelCityCode" type="tns:StringLength1to8" use="optional"/>
                <xs:attribute name="HotelName" type="tns:StringLength1to128" use="optional"/>
                <xs:attribute name="HotelCodeContext" type="tns:StringLength1to32" use="optional"/>
                <xs:attribute name="ChainName" type="tns:StringLength1to64" use="optional"/>
                <xs:attribute name="BrandName" type="tns:StringLength1to64" use="optional"/>
                <xs:attributeGroup ref="tns:AreaID_Group"/>
            </xs:attributeGroup>
            <xs:attributeGroup name="AreaID_Group">
                <xs:attribute name="AreaID" type="tns:NumericStringLength1to8" use="optional"/>
            </xs:attributeGroup>
            <xs:simpleType name="RPH_Type">
                <xs:restriction base="xs:string">
                    <xs:pattern value="[0-9]{1,8}"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:attributeGroup name="LoyaltyCertificateNumberGroup1">
                <xs:attribute name="CertificateNumber" type="tns:StringLength1to32" use="optional"/>
                <xs:attribute name="MemberNumber" type="tns:StringLength1to32" use="optional"/>
                <xs:attribute name="ProgramName" type="tns:StringLength1to64" use="optional"/>
            </xs:attributeGroup>
            <xs:attributeGroup name="ID_OptionalGroup">
                <xs:attribute name="ID" type="tns:StringLength1to32" use="optional"/>
            </xs:attributeGroup>
            <xs:attributeGroup name="LoyaltyCertificateNumberGroup">
                <xs:attribute name="CertificateNumber" type="tns:StringLength1to32" use="optional"/>
                <xs:attribute name="MemberNumber" type="tns:StringLength1to32" use="optional"/>
                <xs:attribute name="ProgramName" type="tns:StringLength1to64" use="optional"/>
            </xs:attributeGroup>
            <xs:attributeGroup name="EffectiveExpireOptionalDateGroup">
                <xs:attribute name="EffectiveDate" type="xs:date" use="optional"/>
                <xs:attribute name="ExpireDate" type="xs:date" use="optional"/>
                <xs:attribute name="ExpireDateExclusiveIndicator" type="xs:boolean" use="optional"/>
            </xs:attributeGroup>
            <xs:attributeGroup name="LoyaltyCertificateGroup">
                <xs:attributeGroup ref="tns:ID_OptionalGroup"/>
                <xs:attribute name="ID_Context" type="tns:StringLength1to32" use="optional"/>
                <xs:attributeGroup ref="tns:LoyaltyCertificateNumberGroup"/>
                <xs:attributeGroup ref="tns:EffectiveExpireOptionalDateGroup"/>
                <xs:attribute name="NmbrOfNights" type="xs:nonNegativeInteger" use="optional"/>
                <xs:attribute name="Format" use="optional">
                    <xs:simpleType>
                        <xs:restriction base="xs:NMTOKEN">
                            <xs:enumeration value="Paper"/>
                            <xs:enumeration value="Electronic"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
                <xs:attribute name="Status" type="tns:StringLength1to16" use="optional"/>
            </xs:attributeGroup>
            <xs:element name="LoyaltyCertificate" minOccurs="0" maxOccurs="9">
                <xs:complexType>
                    <xs:attributeGroup ref="tns:LoyaltyCertificateGroup"/>
                </xs:complexType>
            </xs:element>
            <xs:element name="LoyaltyRedemption">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="LoyaltyCertificate" minOccurs="0" maxOccurs="9">
                            <xs:complexType>
                                <xs:attributeGroup ref="tns:LoyaltyCertificateGroup"/>
                            </xs:complexType>
                        </xs:element>
                    </xs:sequence>
                    <xs:attributeGroup ref="tns:LoyaltyCertificateNumberGroup"/>
                    <xs:attributeGroup ref="tns:PromotionCodeGroup"/>
                    <xs:attribute name="RedemptionQuantity" type="xs:positiveInteger" use="optional"/>
                </xs:complexType>
            </xs:element>
            <xs:attributeGroup name="IssuerNameGroup">
                <xs:attribute name="BankID" type="tns:StringLength1to64"/>
            </xs:attributeGroup>
            <xs:simpleType name="StringLength0to64">
                <xs:restriction base="xs:string">
                    <xs:minLength value="0"/>
                    <xs:maxLength value="64"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:simpleType name="NumericStringLength1to5">
                <xs:restriction base="xs:string">
                    <xs:pattern value="[0-9]{1,5}"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:complexType name="StreetNmbrType">
                <xs:simpleContent>
                    <xs:extension base="tns:StringLength0to64">
                        <xs:attribute name="PO_Box" type="tns:StringLength1to16"/>
                    </xs:extension>
                </xs:simpleContent>
            </xs:complexType>
            <xs:simpleType name="StringLength1to255">
                <xs:restriction base="xs:string">
                    <xs:minLength value="1"/>
                    <xs:maxLength value="255"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:simpleType name="StateProvCodeType">
                <xs:restriction base="tns:StringLength1to8">
                    <xs:minLength value="2"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:complexType name="StateProvType">
                <xs:simpleContent>
                    <xs:extension base="tns:StringLength0to64">
                        <xs:attribute name="StateCode" type="tns:StateProvCodeType"/>
                    </xs:extension>
                </xs:simpleContent>
            </xs:complexType>
            <xs:simpleType name="ISO3166">
                <xs:restriction base="xs:string">
                    <xs:pattern value="[a-zA-Z]{2}"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:complexType name="CountryNameType">
                <xs:simpleContent>
                    <xs:extension base="tns:StringLength0to64">
                        <xs:attribute name="Code" type="tns:ISO3166" use="optional"/>
                    </xs:extension>
                </xs:simpleContent>
            </xs:complexType>
            <xs:attributeGroup name="FormattedInd">
                <xs:attribute name="FormattedInd" type="xs:boolean" use="optional" default="false"/>
            </xs:attributeGroup>
            <xs:attributeGroup name="PrivacyGroup">
                <xs:attribute name="ShareSynchInd" use="optional">
                    <xs:simpleType>
                        <xs:restriction base="xs:NMTOKEN">
                            <xs:enumeration value="Yes"/>
                            <xs:enumeration value="No"/>
                            <xs:enumeration value="Inherit"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
                <xs:attribute name="ShareMarketInd" use="optional">
                    <xs:simpleType>
                        <xs:restriction base="xs:NMTOKEN">
                            <xs:enumeration value="Yes"/>
                            <xs:enumeration value="No"/>
                            <xs:enumeration value="Inherit"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
            </xs:attributeGroup>
            <xs:complexType name="AddressType">
                <xs:sequence>
                    <xs:element name="StreetNmbr" minOccurs="0">
                        <xs:complexType>
                            <xs:simpleContent>
                                <xs:extension base="tns:StreetNmbrType">
                                    <xs:attribute name="StreetNmbrSuffix" type="tns:StringLength1to8" use="optional"/>
                                    <xs:attribute name="StreetDirection" type="tns:StringLength1to8" use="optional"/>
                                    <xs:attribute name="RuralRouteNmbr" type="tns:NumericStringLength1to5"
                                                  use="optional"/>
                                </xs:extension>
                            </xs:simpleContent>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="BldgRoom" minOccurs="0" maxOccurs="2">
                        <xs:complexType>
                            <xs:simpleContent>
                                <xs:extension base="tns:StringLength0to64">
                                    <xs:attribute name="BldgNameIndicator" type="xs:boolean" use="optional"/>
                                </xs:extension>
                            </xs:simpleContent>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="AddressLine" type="tns:StringLength1to255" minOccurs="0" maxOccurs="5"/>
                    <xs:element name="CityName" type="tns:StringLength1to64" minOccurs="0"/>
                    <xs:element name="PostalCode" type="tns:StringLength1to16" minOccurs="0"/>
                    <xs:element name="County" type="tns:StringLength1to32" minOccurs="0"/>
                    <xs:element name="StateProv" type="tns:StateProvType" minOccurs="0"/>
                    <xs:element name="CountryName" type="tns:CountryNameType" minOccurs="0"/>
                </xs:sequence>
                <xs:attributeGroup ref="tns:FormattedInd"/>
                <xs:attributeGroup ref="tns:PrivacyGroup"/>
                <xs:attribute name="Type" type="tns:OTA_CodeType" use="optional"/>
                <xs:attribute name="Remark" type="tns:StringLength1to128" use="optional"/>
            </xs:complexType>
            <xs:simpleType name="NumericStringLength1to3">
                <xs:restriction base="xs:string">
                    <xs:pattern value="[0-9]{1,3}"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:attributeGroup name="TelephoneAttributesGroup">
                <xs:attribute name="PhoneLocationType" type="tns:OTA_CodeType" use="optional"/>
                <xs:attribute name="PhoneTechType" type="tns:OTA_CodeType" use="optional"/>
                <xs:attribute name="PhoneUseType" type="tns:OTA_CodeType" use="optional"/>
                <xs:attribute name="CountryAccessCode" type="tns:NumericStringLength1to3" use="optional"/>
                <xs:attribute name="AreaCityCode" type="tns:NumericStringLength1to8" use="optional"/>
                <xs:attribute name="PhoneNumber" type="tns:StringLength1to32" use="required"/>
                <xs:attribute name="Extension" type="tns:NumericStringLength1to5" use="optional"/>
                <xs:attribute name="PIN" type="tns:StringLength1to8" use="optional"/>
                <xs:attribute name="Remark" type="tns:StringLength1to128" use="optional"/>
            </xs:attributeGroup>
            <xs:attributeGroup name="DefaultIndGroup">
                <xs:attribute name="DefaultInd" type="xs:boolean" use="optional" default="false"/>
            </xs:attributeGroup>
            <xs:attributeGroup name="TelephoneGroup">
                <xs:attributeGroup ref="tns:PrivacyGroup"/>
                <xs:attributeGroup ref="tns:TelephoneAttributesGroup"/>
                <xs:attributeGroup ref="tns:FormattedInd"/>
            </xs:attributeGroup>
            <xs:attributeGroup name="TelephoneInfoGroup">
                <xs:attributeGroup ref="tns:TelephoneGroup"/>
                <xs:attributeGroup ref="tns:DefaultIndGroup"/>
                <xs:attribute name="RPH" type="tns:RPH_Type" use="optional"/>
            </xs:attributeGroup>
            <xs:simpleType name="UpperCaseAlphaLength1to2">
                <xs:restriction base="xs:string">
                    <xs:pattern value="[A-Z]{1,2}"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:simpleType name="PaymentCardCodeType">
                <xs:union>
                    <xs:simpleType>
                        <xs:restriction base="tns:UpperCaseAlphaLength1to2">
                            <xs:enumeration value="AX"/>
                            <xs:enumeration value="BC"/>
                            <xs:enumeration value="BL"/>
                            <xs:enumeration value="CB"/>
                            <xs:enumeration value="DN"/>
                            <xs:enumeration value="DS"/>
                            <xs:enumeration value="EC"/>
                            <xs:enumeration value="JC"/>
                            <xs:enumeration value="MA"/>
                            <xs:enumeration value="MC"/>
                            <xs:enumeration value="TP"/>
                            <xs:enumeration value="VI"/>
                        </xs:restriction>
                    </xs:simpleType>
                    <xs:simpleType>
                        <xs:restriction base="tns:UpperCaseAlphaLength1to2"/>
                    </xs:simpleType>
                </xs:union>
            </xs:simpleType>
            <xs:simpleType name="NumericStringLength1to19">
                <xs:restriction base="xs:string">
                    <xs:pattern value="[0-9]{1,19}"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:simpleType name="MMYYDate">
                <xs:restriction base="xs:string">
                    <xs:pattern value="(0[1-9]|1[0-2])[0-9][0-9]"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:attributeGroup name="PaymentCardDateGroup">
                <xs:attribute name="EffectiveDate" type="tns:MMYYDate" use="optional"/>
                <xs:attribute name="ExpireDate" type="tns:MMYYDate" use="optional"/>
            </xs:attributeGroup>
            <xs:simpleType name="AlphaNumericStringLength1to19">
                <xs:restriction base="xs:string">
                    <xs:pattern value="[0-9a-zA-Z]{1,19}"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:complexType name="PaymentCardType">
                <xs:sequence>
                    <xs:element name="CardHolderName" type="tns:StringLength1to64" minOccurs="0">
                    </xs:element>
                    <xs:element name="CardIssuerName" minOccurs="0">
                        <xs:complexType>
                            <xs:attributeGroup ref="tns:IssuerNameGroup"/>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="Address" type="tns:AddressType" minOccurs="0"/>
                    <xs:element name="Telephone" minOccurs="0" maxOccurs="5">
                        <xs:complexType>
                            <xs:attributeGroup ref="tns:TelephoneInfoGroup"/>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="SignatureOnFile" minOccurs="0">
                        <xs:complexType>
                            <xs:attribute name="SignatureOnFileIndicator" type="xs:boolean" use="optional"/>
                            <xs:attributeGroup ref="tns:EffectiveExpireOptionalDateGroup"/>
                        </xs:complexType>
                    </xs:element>
                </xs:sequence>
                <xs:attributeGroup ref="tns:PrivacyGroup"/>
                <xs:attribute name="CardType" type="tns:OTA_CodeType" use="optional"/>
                <xs:attribute name="CardCode" type="tns:PaymentCardCodeType" use="optional"/>
                <xs:attribute name="CardNumber" type="tns:NumericStringLength1to19" use="optional"/>
                <xs:attribute name="SeriesCode" type="tns:NumericStringLength1to8" use="optional"/>
                <xs:attributeGroup ref="tns:PaymentCardDateGroup"/>
                <xs:attribute name="MaskedCardNumber" type="tns:AlphaNumericStringLength1to19" use="optional"/>
                <xs:attribute name="CardHolderRPH" type="tns:RPH_Type" use="optional"/>
                <xs:attribute name="ExtendPaymentIndicator" type="xs:boolean" use="optional"/>
                <xs:attribute name="CountryOfIssue" type="tns:ISO3166" use="optional"/>
            </xs:complexType>
            <xs:complexType name="BankAcctType">
                <xs:sequence>
                    <xs:element name="BankAcctName" type="tns:StringLength1to64" minOccurs="0"/>
                </xs:sequence>
                <xs:attributeGroup ref="tns:PrivacyGroup"/>
                <xs:attribute name="BankID" type="tns:StringLength1to64" use="optional"/>
                <xs:attribute name="AcctType" type="tns:StringLength1to32" use="optional"/>
                <xs:attribute name="BankAcctNumber" type="tns:StringLength1to32" use="optional"/>
                <xs:attribute name="ChecksAcceptedInd" type="xs:boolean" use="optional"/>
            </xs:complexType>
            <xs:complexType name="AddressType">
                <xs:sequence>
                    <xs:element name="StreetNmbr" minOccurs="0">
                        <xs:complexType>
                            <xs:simpleContent>
                                <xs:extension base="tns:StreetNmbrType">
                                    <xs:attribute name="StreetNmbrSuffix" type="tns:StringLength1to8" use="optional"/>
                                    <xs:attribute name="StreetDirection" type="tns:StringLength1to8" use="optional"/>
                                    <xs:attribute name="RuralRouteNmbr" type="tns:NumericStringLength1to5"
                                                  use="optional"/>
                                </xs:extension>
                            </xs:simpleContent>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="BldgRoom" minOccurs="0" maxOccurs="2">
                        <xs:complexType>
                            <xs:simpleContent>
                                <xs:extension base="tns:StringLength0to64">
                                    <xs:attribute name="BldgNameIndicator" type="xs:boolean" use="optional"/>
                                </xs:extension>
                            </xs:simpleContent>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="AddressLine" type="tns:StringLength1to255" minOccurs="0" maxOccurs="5"/>
                    <xs:element name="CityName" type="tns:StringLength1to64" minOccurs="0"/>
                    <xs:element name="PostalCode" type="tns:StringLength1to16" minOccurs="0"/>
                    <xs:element name="County" type="tns:StringLength1to32" minOccurs="0"/>
                    <xs:element name="StateProv" type="tns:StateProvType" minOccurs="0"/>
                    <xs:element name="CountryName" type="tns:CountryNameType" minOccurs="0"/>
                </xs:sequence>
                <xs:attributeGroup ref="tns:FormattedInd"/>
                <xs:attributeGroup ref="tns:PrivacyGroup"/>
                <xs:attribute name="Type" type="tns:OTA_CodeType" use="optional"/>
                <xs:attribute name="Remark" type="tns:StringLength1to128" use="optional"/>
            </xs:complexType>
            <xs:complexType name="AddressInfoType">
                <xs:annotation>
                    <xs:documentation xml:lang="en">Information about an address that identifies a location for a
                        specific purposes.
                    </xs:documentation>
                </xs:annotation>
                <xs:complexContent>
                    <xs:extension base="tns:AddressType">
                        <xs:attributeGroup ref="tns:DefaultIndGroup"/>
                        <xs:attribute name="UseType" type="tns:OTA_CodeType" use="optional"/>
                        <xs:attribute name="RPH" type="tns:RPH_Type" use="optional"/>
                    </xs:extension>
                </xs:complexContent>
            </xs:complexType>
            <xs:complexType name="EmailType">
                <xs:annotation>
                    <xs:documentation xml:lang="en">Electronic email addresses, in IETF specified format.
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleContent>
                    <xs:extension base="tns:StringLength1to128">
                        <xs:attributeGroup ref="tns:PrivacyGroup"/>
                        <xs:attributeGroup ref="tns:DefaultIndGroup"/>
                        <xs:attribute name="EmailType" type="tns:OTA_CodeType" use="optional"/>
                        <xs:attribute name="RPH" type="tns:RPH_Type" use="optional"/>
                        <xs:attribute name="Remark" type="tns:StringLength1to128" use="optional"/>
                    </xs:extension>
                </xs:simpleContent>
            </xs:complexType>
            <xs:complexType name="DirectBillType">
                <xs:sequence>
                    <xs:element name="CompanyName" minOccurs="0">
                        <xs:complexType>
                            <xs:simpleContent>
                                <xs:extension base="tns:CompanyNameType">
                                    <xs:attribute name="ContactName" type="tns:StringLength1to64" use="optional"/>
                                </xs:extension>
                            </xs:simpleContent>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="Address" type="tns:AddressInfoType" minOccurs="0"/>
                    <xs:element name="Email" type="tns:EmailType" minOccurs="0"/>
                    <xs:element name="Telephone" minOccurs="0">
                        <xs:complexType>
                            <xs:attributeGroup ref="tns:TelephoneInfoGroup"/>
                        </xs:complexType>
                    </xs:element>
                </xs:sequence>
                <xs:attributeGroup ref="tns:PrivacyGroup"/>
                <xs:attribute name="DirectBill_ID" type="tns:StringLength1to32" use="optional"/>
                <xs:attribute name="BillingNumber" type="tns:StringLength0to64" use="optional"/>
            </xs:complexType>
            <xs:attributeGroup name="VoucherGroup">
                <xs:attributeGroup ref="tns:EffectiveExpireOptionalDateGroup"/>
                <xs:attribute name="SeriesCode" type="tns:StringLength1to32"/>
            </xs:attributeGroup>
            <xs:complexType name="PaymentFormType">
                <xs:choice minOccurs="0">
                    <xs:element name="PaymentCard" type="tns:PaymentCardType"/>
                    <xs:element name="BankAcct" type="tns:BankAcctType"/>
                    <xs:element name="DirectBill" type="tns:DirectBillType"/>
                    <xs:element name="Voucher">
                        <xs:complexType>
                            <xs:attributeGroup ref="tns:VoucherGroup"/>
                            <xs:attribute name="BillingNumber" type="tns:StringLength1to64" use="optional"/>
                            <xs:attribute name="SupplierIdentifier" type="tns:StringLength1to64" use="optional"/>
                            <xs:attribute name="Identifier" type="tns:StringLength1to64" use="optional"/>
                            <xs:attribute name="ValueType" type="tns:StringLength1to32" use="optional"/>
                            <xs:attribute name="ElectronicIndicator" type="xs:boolean" use="optional"/>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="LoyaltyRedemption">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="LoyaltyCertificate" minOccurs="0" maxOccurs="9">
                                    <xs:complexType>
                                        <xs:attributeGroup ref="tns:LoyaltyCertificateGroup"/>
                                    </xs:complexType>
                                </xs:element>
                            </xs:sequence>
                            <xs:attributeGroup ref="tns:LoyaltyCertificateNumberGroup"/>
                            <xs:attributeGroup ref="tns:PromotionCodeGroup"/>
                            <xs:attribute name="RedemptionQuantity" type="xs:positiveInteger" use="optional"/>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="MiscChargeOrder">
                        <xs:complexType>
                            <xs:attribute name="TicketNumber" type="tns:StringLength1to32"/>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="Cash">
                        <xs:complexType>
                            <xs:attribute name="CashIndicator" type="xs:boolean" use="optional" default="true"/>
                        </xs:complexType>
                    </xs:element>
                </xs:choice>
                <xs:attributeGroup ref="tns:PrivacyGroup"/>
                <xs:attribute name="CostCenterID" type="tns:StringLength1to32" use="optional"/>
                <xs:attribute name="RPH" type="tns:RPH_Type" use="optional"/>
                <xs:attribute name="PaymentTransactionTypeCode" use="optional">
                    <xs:simpleType>
                        <xs:restriction base="xs:NMTOKEN">
                            <xs:enumeration value="charge"/>
                            <xs:enumeration value="reserve"/>
                            <xs:enumeration value="refund"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
                <xs:attribute name="GuaranteeIndicator" type="xs:boolean" use="optional"/>
                <xs:attribute name="GuaranteeTypeCode" type="tns:OTA_CodeType" use="optional"/>
                <xs:attribute name="GuaranteeID" type="tns:StringLength1to64" use="optional"/>
                <xs:attribute name="Remark" type="tns:StringLength1to128" use="optional"/>
            </xs:complexType>
            <xs:simpleType name="TimeOrDateTimeType">
                <xs:union memberTypes="xs:dateTime xs:time"/>
            </xs:simpleType>
            <xs:simpleType name="Numeric0to999">
                <xs:restriction base="xs:integer">
                    <xs:minInclusive value="0"/>
                    <xs:maxInclusive value="999"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:attributeGroup name="DeadlineGroup">
                <xs:attribute name="AbsoluteDeadline" type="tns:TimeOrDateTimeType" use="optional"/>
                <xs:attribute name="OffsetTimeUnit" type="tns:TimeUnitType" use="optional"/>
                <xs:attribute name="OffsetUnitMultiplier" type="tns:Numeric0to999" use="optional"/>
                <xs:attribute name="OffsetDropTime" use="optional">
                    <xs:simpleType>
                        <xs:restriction base="xs:NMTOKEN">
                            <xs:enumeration value="BeforeArrival"/>
                            <xs:enumeration value="AfterBooking"/>
                            <xs:enumeration value="AfterConfirmation"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
            </xs:attributeGroup>
            <xs:complexType name="CommentType">
                <xs:sequence>
                    <xs:element name="Comment" maxOccurs="unbounded">
                        <xs:complexType>
                            <xs:complexContent>
                                <xs:extension base="tns:ParagraphType">
                                    <xs:attribute name="CommentOriginatorCode" type="tns:StringLength1to16"
                                                  use="optional"/>
                                    <xs:attribute name="GuestViewable" type="xs:boolean" use="optional"/>
                                </xs:extension>
                            </xs:complexContent>
                        </xs:complexType>
                    </xs:element>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="GuaranteeType">
                <xs:sequence>
                    <xs:element name="GuaranteesAccepted" minOccurs="0">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="GuaranteeAccepted" maxOccurs="unbounded">
                                    <xs:complexType>
                                        <xs:complexContent>
                                            <xs:extension base="tns:PaymentFormType">
                                                <xs:attribute name="Default" type="xs:boolean"/>
                                                <xs:attribute name="NoCardHolderInfoReqInd" type="xs:boolean"
                                                              use="optional"/>
                                                <xs:attribute name="NameReqInd" type="xs:boolean" use="optional"/>
                                                <xs:attribute name="AddressReqInd" type="xs:boolean" use="optional"/>
                                                <xs:attribute name="PhoneReqInd" type="xs:boolean" use="optional"/>
                                                <xs:attribute name="InterbankNbrReqInd" type="xs:boolean"
                                                              use="optional"/>
                                                <xs:attribute name="BookingSourceAllowedInd" type="xs:boolean"
                                                              use="optional"/>
                                                <xs:attribute name="CorpDiscountNbrAllowedInd" type="xs:boolean"
                                                              use="optional"/>
                                            </xs:extension>
                                        </xs:complexContent>
                                    </xs:complexType>
                                </xs:element>
                            </xs:sequence>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="Deadline" minOccurs="0">
                        <xs:complexType>
                            <xs:attributeGroup ref="tns:DeadlineGroup"/>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="Comments" type="tns:CommentType" minOccurs="0"/>
                    <xs:element name="GuaranteeDescription" type="tns:ParagraphType" minOccurs="0" maxOccurs="9"/>
                </xs:sequence>
                <xs:attribute name="RetributionType" use="optional">
                    <xs:simpleType>
                        <xs:restriction base="tns:StringLength1to32">
                            <xs:enumeration value="ResAutoCancelled"/>
                            <xs:enumeration value="ResNotGuaranteed"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
                <xs:attribute name="GuaranteeCode" type="tns:StringLength1to32" use="optional"/>
                <xs:attribute name="GuaranteeType" use="optional">
                    <xs:simpleType>
                        <xs:restriction base="tns:StringLength1to32">
                            <xs:enumeration value="GuaranteeRequired"/>
                            <xs:enumeration value="None"/>
                            <xs:enumeration value="CC/DC/Voucher"/>
                            <xs:enumeration value="Profile"/>
                            <xs:enumeration value="Deposit"/>
                            <xs:enumeration value="PrePay">
                            </xs:enumeration>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
                <xs:attribute name="HoldTime" type="xs:time" use="optional"/>
            </xs:complexType>
            <xs:simpleType name="Percentage">
                <xs:restriction base="xs:decimal">
                    <xs:minInclusive value="0.00"/>
                    <xs:maxInclusive value="100.00"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:complexType name="AmountPercentType">
                <xs:sequence>
                    <xs:element name="Taxes" type="tns:TaxesType" minOccurs="0"/>
                </xs:sequence>
                <xs:attribute name="TaxInclusive" type="xs:boolean" use="optional"/>
                <xs:attribute name="FeesInclusive" type="xs:boolean" use="optional"/>
                <xs:attribute name="NmbrOfNights" type="xs:nonNegativeInteger" use="optional"/>
                <xs:attribute name="BasisType" use="optional">
                    <xs:simpleType>
                        <xs:restriction base="tns:StringLength1to16">
                            <xs:enumeration value="FullStay"/>
                            <xs:enumeration value="Nights"/>
                            <xs:enumeration value="FirstLast"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
                <xs:attribute name="Percent" type="tns:Percentage" use="optional"/>
                <xs:attributeGroup ref="tns:CurrencyAmountGroup"/>
                <xs:attribute name="ApplyAs" use="optional">
                    <xs:simpleType>
                        <xs:restriction base="xs:NMTOKEN">
                            <xs:enumeration value="FirstNightDeposit"/>
                            <xs:enumeration value="LastNightDepost"/>
                            <xs:enumeration value="FirstAndLastNightDeposit"/>
                            <xs:enumeration value="FirstNightPayment"/>
                            <xs:enumeration value="LastNightPayment"/>
                            <xs:enumeration value="FirstAndLastNightPayment"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
            </xs:complexType>
            <xs:complexType name="CancelPenaltyType">
                <xs:sequence>
                    <xs:element name="Deadline" minOccurs="0">
                        <xs:complexType>
                            <xs:attributeGroup ref="tns:DeadlineGroup"/>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="AmountPercent" type="tns:AmountPercentType" minOccurs="0"/>
                    <xs:element name="PenaltyDescription" type="tns:ParagraphType" minOccurs="0" maxOccurs="9"/>
                </xs:sequence>
                <xs:attribute name="ConfirmClassCode" type="tns:StringLength1to16" use="optional"/>
                <xs:attribute name="PolicyCode" type="tns:StringLength1to16" use="optional"/>
                <xs:attribute name="NonRefundable" type="xs:boolean" use="optional"/>
                <xs:attributeGroup ref="tns:DOW_PatternGroup"/>
                <xs:attributeGroup ref="tns:DateTimeSpanGroup"/>
                <xs:attribute name="RoomTypeCode" type="tns:StringLength1to16" use="optional"/>
            </xs:complexType>
            <xs:complexType name="CancelPenaltiesType">
                <xs:sequence>
                    <xs:element name="CancelPenalty" type="tns:CancelPenaltyType" minOccurs="0" maxOccurs="unbounded"/>
                </xs:sequence>
                <xs:attribute name="CancelPolicyIndicator" type="xs:boolean" use="optional"/>
            </xs:complexType>
            <xs:complexType name="AcceptedPaymentsType">
                <xs:sequence>
                    <xs:element name="AcceptedPayment" type="tns:PaymentFormType" maxOccurs="unbounded"/>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="TPA_ExtensionsType">
                <xs:sequence>
                    <xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded"/>
                </xs:sequence>
            </xs:complexType>
            <xs:simpleType name="InfoSourceType">
                <xs:restriction base="xs:string">
                    <xs:minLength value="1"/>
                    <xs:maxLength value="32"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:complexType name="RequiredPaymentsType">
                <xs:sequence>
                    <xs:element name="GuaranteePayment" maxOccurs="unbounded">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="AcceptedPayments" type="tns:AcceptedPaymentsType" minOccurs="0"/>
                                <xs:element name="AmountPercent" type="tns:AmountPercentType" minOccurs="0"/>
                                <xs:element name="Deadline" minOccurs="0" maxOccurs="2">
                                    <xs:complexType>
                                        <xs:attributeGroup ref="tns:DeadlineGroup"/>
                                    </xs:complexType>
                                </xs:element>
                                <xs:element name="Description" type="tns:ParagraphType" minOccurs="0" maxOccurs="5"/>
                                <xs:element name="Address" minOccurs="0" maxOccurs="3">
                                    <xs:complexType>
                                        <xs:complexContent>
                                            <xs:extension base="tns:AddressInfoType">
                                                <xs:attribute name="AddresseeName" type="tns:StringLength1to64"
                                                              use="optional"/>
                                            </xs:extension>
                                        </xs:complexContent>
                                    </xs:complexType>
                                </xs:element>
                                <xs:element name="TPA_Extensions" type="tns:TPA_ExtensionsType" minOccurs="0"/>
                            </xs:sequence>
                            <xs:attribute name="RetributionType" use="optional">
                                <xs:simpleType>
                                    <xs:restriction base="tns:StringLength1to32">
                                        <xs:enumeration value="ResAutoCancelled"/>
                                        <xs:enumeration value="ResNotGuaranteed"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:attribute>
                            <xs:attribute name="PaymentCode" type="tns:StringLength1to8" use="optional"/>
                            <xs:attribute name="Type" use="optional">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="RequiredPayment"/>
                                        <xs:enumeration value="GuaranteePolicy"/>
                                        <xs:enumeration value="AcceptedPaymentForms"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:attribute>
                            <xs:attribute name="GuaranteeCode" type="tns:StringLength1to32" use="optional"/>
                            <xs:attribute name="GuaranteeType" use="optional">
                                <xs:simpleType>
                                    <xs:restriction base="tns:StringLength1to32">
                                        <xs:enumeration value="GuaranteeRequired"/>
                                        <xs:enumeration value="None"/>
                                        <xs:enumeration value="CC/DC/Voucher"/>
                                        <xs:enumeration value="Profile"/>
                                        <xs:enumeration value="Deposit"/>
                                        <xs:enumeration value="PrePay"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:attribute>
                            <xs:attribute name="HoldTime" type="xs:time" use="optional"/>
                            <xs:attributeGroup ref="tns:DOW_PatternGroup"/>
                            <xs:attributeGroup ref="tns:DateTimeSpanGroup"/>
                            <xs:attribute name="NoCardHolderInfoReqInd" type="xs:boolean" use="optional"/>
                            <xs:attribute name="NameInd" type="xs:boolean" use="optional"/>
                            <xs:attribute name="AddressInd" type="xs:boolean" use="optional"/>
                            <xs:attribute name="PhoneInd" type="xs:boolean" use="optional"/>
                            <xs:attribute name="InterbankNbrInd" type="xs:boolean" use="optional"/>
                            <xs:attribute name="RoomTypeCode" type="tns:StringLength1to16" use="optional"/>
                            <xs:attribute name="InfoSource" type="tns:InfoSourceType" use="optional"/>
                            <xs:attribute name="NonRefundableIndicator" type="xs:boolean" use="optional"/>
                            <xs:attribute name="PolicyCode" type="tns:StringLength1to16" use="optional"/>
                        </xs:complexType>
                    </xs:element>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="DOW_RestrictionsType">
                <xs:sequence>
                    <xs:element name="AvailableDaysOfWeek" minOccurs="0">
                        <xs:complexType>
                            <xs:attributeGroup ref="tns:DOW_PatternGroup"/>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="ArrivalDaysOfWeek" minOccurs="0">
                        <xs:complexType>
                            <xs:attributeGroup ref="tns:DOW_PatternGroup"/>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="DepartureDaysOfWeek" minOccurs="0">
                        <xs:complexType>
                            <xs:attributeGroup ref="tns:DOW_PatternGroup"/>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="RequiredDaysOfWeek" minOccurs="0">
                        <xs:complexType>
                            <xs:attributeGroup ref="tns:DOW_PatternGroup"/>
                        </xs:complexType>
                    </xs:element>
                </xs:sequence>
            </xs:complexType>
            <xs:attributeGroup name="DisplayGroup">
                <xs:attribute name="RestrictedDisplayIndicator" type="xs:boolean" use="optional"/>
                <xs:attribute name="Sort" type="xs:nonNegativeInteger" use="optional"/>
            </xs:attributeGroup>
            <xs:attributeGroup name="ProfileTypeGroup">
                <xs:attribute name="ProfileType" type="tns:OTA_CodeType" use="optional"/>
            </xs:attributeGroup>
            <xs:complexType name="ProfileType">
                <xs:attributeGroup ref="tns:ProfileTypeGroup"/>
            </xs:complexType>
            <xs:attributeGroup name="RemovalGroup">
                <xs:attribute name="Removal" type="xs:boolean" use="optional" default="false"/>
            </xs:attributeGroup>
            <xs:attributeGroup name="CodeInfoGroup">
                <xs:attribute name="CodeDetail" type="tns:StringLength1to64" use="optional"/>
                <xs:attributeGroup ref="tns:RemovalGroup"/>
            </xs:attributeGroup>
            <xs:complexType name="ViewershipsType">
                <xs:sequence>
                    <xs:element name="Viewership" maxOccurs="unbounded">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="ViewershipCodes" minOccurs="0">
                                    <xs:complexType>
                                        <xs:sequence>
                                            <xs:element name="ViewershipCode" type="xs:string"/>
                                        </xs:sequence>
                                    </xs:complexType>
                                </xs:element>
                                <xs:element name="SystemCodes" minOccurs="0">
                                    <xs:complexType>
                                        <xs:sequence>
                                            <xs:element name="SystemCode" maxOccurs="unbounded">
                                                <xs:complexType>
                                                    <xs:simpleContent>
                                                        <xs:extension base="xs:string">
                                                            <xs:attributeGroup ref="tns:DisplayGroup"/>
                                                        </xs:extension>
                                                    </xs:simpleContent>
                                                </xs:complexType>
                                            </xs:element>
                                        </xs:sequence>
                                        <xs:attribute name="SystemCodesInclusive" type="xs:boolean" use="optional"/>
                                    </xs:complexType>
                                </xs:element>
                                <xs:element name="ProfileTypes" minOccurs="0">
                                    <xs:complexType>
                                        <xs:sequence>
                                            <xs:element name="ProfileType" maxOccurs="unbounded">
                                                <xs:complexType>
                                                    <xs:attributeGroup ref="tns:ProfileTypeGroup"/>
                                                </xs:complexType>
                                            </xs:element>
                                        </xs:sequence>
                                    </xs:complexType>
                                </xs:element>
                                <xs:element name="ProfileRefs" minOccurs="0">
                                    <xs:complexType>
                                        <xs:sequence>
                                            <xs:element name="ProfileRef" type="tns:UniqueID_Type"
                                                        maxOccurs="unbounded"/>
                                        </xs:sequence>
                                    </xs:complexType>
                                </xs:element>
                                <xs:element name="Profiles" minOccurs="0">
                                    <xs:complexType>
                                        <xs:sequence>
                                            <xs:element name="Profile" type="tns:ProfileType" maxOccurs="unbounded"/>
                                        </xs:sequence>
                                    </xs:complexType>
                                </xs:element>
                                <xs:element name="LocationCodes" minOccurs="0">
                                    <xs:complexType>
                                        <xs:sequence>
                                            <xs:element name="LocationCode" maxOccurs="unbounded">
                                                <xs:complexType>
                                                    <xs:attribute name="CityCode" type="tns:StringLength1to8"
                                                                  use="optional"/>
                                                    <xs:attribute name="StateProvinceCode" type="tns:StringLength1to8"
                                                                  use="optional"/>
                                                    <xs:attribute name="CountryCode" type="tns:ISO3166" use="optional"/>
                                                </xs:complexType>
                                            </xs:element>
                                        </xs:sequence>
                                        <xs:attribute name="LocationCodesInclusive" type="xs:boolean" use="optional"/>
                                    </xs:complexType>
                                </xs:element>
                                <xs:element name="BookingChannelCodes" minOccurs="0">
                                    <xs:complexType>
                                        <xs:sequence>
                                            <xs:element name="BookingChannelCode" maxOccurs="unbounded">
                                                <xs:complexType>
                                                    <xs:simpleContent>
                                                        <xs:extension base="xs:string">
                                                            <xs:attributeGroup ref="tns:DisplayGroup"/>
                                                        </xs:extension>
                                                    </xs:simpleContent>
                                                </xs:complexType>
                                            </xs:element>
                                        </xs:sequence>
                                        <xs:attribute name="ChannelCodesInclusive" type="xs:boolean" use="optional"/>
                                    </xs:complexType>
                                </xs:element>
                                <xs:element name="DistributorTypes" minOccurs="0">
                                    <xs:complexType>
                                        <xs:sequence>
                                            <xs:element name="DistributorType" maxOccurs="unbounded">
                                                <xs:complexType>
                                                    <xs:simpleContent>
                                                        <xs:extension base="xs:string">
                                                            <xs:attribute name="DistributorCode"
                                                                          type="tns:StringLength1to16"/>
                                                            <xs:attribute name="DistributorTypeCode"
                                                                          type="tns:StringLength1to16"/>
                                                        </xs:extension>
                                                    </xs:simpleContent>
                                                </xs:complexType>
                                            </xs:element>
                                        </xs:sequence>
                                    </xs:complexType>
                                </xs:element>
                            </xs:sequence>
                            <xs:attribute name="ViewershipRPH" type="xs:byte" use="optional"/>
                            <xs:attribute name="ViewOnly" type="xs:boolean" use="optional"/>
                        </xs:complexType>
                    </xs:element>
                </xs:sequence>
            </xs:complexType>
            <xs:attributeGroup name="CodeGroup">
                <xs:attribute name="Code" type="tns:StringLength1to8" use="optional"/>
                <xs:attribute name="CodeContext" type="tns:StringLength1to32" use="optional"/>
            </xs:attributeGroup>
            <xs:attributeGroup name="QuantityGroup">
                <xs:attribute name="Quantity" type="xs:nonNegativeInteger" use="optional"/>
            </xs:attributeGroup>
            <xs:attributeGroup name="CodeListGroup">
                <xs:attributeGroup ref="tns:CodeGroup"/>
                <xs:attribute name="URI" type="xs:anyURI" use="optional"/>
                <xs:attributeGroup ref="tns:QuantityGroup"/>
            </xs:attributeGroup>
            <xs:simpleType name="DateOrTimeOrDateTimeType">
                <xs:union memberTypes="xs:date xs:dateTime xs:time"/>
            </xs:simpleType>
            <xs:simpleType name="DateOrDateTimeType">
                <xs:union memberTypes="xs:date xs:dateTime"/>
            </xs:simpleType>
            <xs:attributeGroup name="InvBlockCutoffGroup">
                <xs:attribute name="AbsoluteCutoff" type="tns:DateOrTimeOrDateTimeType" use="optional"/>
                <xs:attribute name="OffsetDuration" type="xs:duration" use="optional"/>
                <xs:attribute name="OffsetCalculationMode" use="optional">
                    <xs:simpleType>
                        <xs:restriction base="xs:NMTOKEN">
                            <xs:enumeration value="BeforeBlockStartDate"/>
                            <xs:enumeration value="AfterBlockCreation"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
            </xs:attributeGroup>
            <xs:complexType name="BookingRulesType">
                <xs:sequence>
                    <xs:element name="BookingRule" maxOccurs="unbounded">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="AcceptableGuarantees" minOccurs="0">
                                    <xs:complexType>
                                        <xs:sequence>
                                            <xs:element name="AcceptableGuarantee" maxOccurs="unbounded">
                                                <xs:complexType>
                                                    <xs:complexContent>
                                                        <xs:extension base="tns:GuaranteeType">
                                                            <xs:attribute name="GuaranteePolicyType" use="optional">
                                                                <xs:simpleType>
                                                                    <xs:restriction base="xs:NMTOKEN">
                                                                        <xs:enumeration value="NoGuaranteesAccepted"/>
                                                                        <xs:enumeration value="GuaranteesAccepted"/>
                                                                        <xs:enumeration value="GuaranteesRequired"/>
                                                                        <xs:enumeration value="DepositRequired"/>
                                                                        <xs:enumeration value="GuaranteesNotRequired"/>
                                                                        <xs:enumeration value="DepositNotRequired"/>
                                                                        <xs:enumeration value="PrepayRequired"/>
                                                                        <xs:enumeration value="PrepayNotRequired"/>
                                                                        <xs:enumeration value="NoDepositsAccepted"/>
                                                                    </xs:restriction>
                                                                </xs:simpleType>
                                                            </xs:attribute>
                                                            <xs:attribute name="PaymentType" type="tns:OTA_CodeType"
                                                                          use="optional"/>
                                                            <xs:attributeGroup ref="tns:CurrencyCodeGroup"/>
                                                            <xs:attribute name="UnacceptablePaymentType"
                                                                          type="tns:OTA_CodeType" use="optional"/>
                                                        </xs:extension>
                                                    </xs:complexContent>
                                                </xs:complexType>
                                            </xs:element>
                                        </xs:sequence>
                                    </xs:complexType>
                                </xs:element>
                                <xs:element name="CancelPenalties" type="tns:CancelPenaltiesType" minOccurs="0"/>
                                <xs:element name="RequiredPaymts" type="tns:RequiredPaymentsType" minOccurs="0"/>
                                <xs:element name="LengthsOfStay" type="tns:LengthsOfStayType" minOccurs="0"/>
                                <xs:element name="DOW_Restrictions" type="tns:DOW_RestrictionsType" minOccurs="0"/>
                                <xs:element name="RestrictionStatus" minOccurs="0"/>
                                <xs:element name="Viewerships" type="tns:ViewershipsType" minOccurs="0"/>
                                <xs:element name="AddtionalRules" minOccurs="0">
                                    <xs:complexType>
                                        <xs:sequence>
                                            <xs:element name="AdditionalRule" maxOccurs="unbounded">
                                                <xs:complexType>
                                                    <xs:attribute name="AdditionalRule" use="optional">
                                                        <xs:simpleType>
                                                            <xs:restriction base="xs:NMTOKEN">
                                                                <xs:enumeration value="IsCancelable"/>
                                                                <xs:enumeration value="IsModifiable"/>
                                                                <xs:enumeration value="IsRefundable"/>
                                                                <xs:enumeration value="NotCancelable"/>
                                                                <xs:enumeration value="NotModifiable"/>
                                                                <xs:enumeration value="NotRefundable"/>
                                                                <xs:enumeration value="IsCommissionable"/>
                                                                <xs:enumeration value="NotCommissionable"/>
                                                                <xs:enumeration value="CertificateRequired"/>
                                                                <xs:enumeration value="ID_Required"/>
                                                            </xs:restriction>
                                                        </xs:simpleType>
                                                    </xs:attribute>
                                                </xs:complexType>
                                            </xs:element>
                                        </xs:sequence>
                                    </xs:complexType>
                                </xs:element>
                                <xs:element name="Description" type="tns:ParagraphType" minOccurs="0" maxOccurs="20"/>
                                <xs:element name="UniqueID" type="tns:UniqueID_Type" minOccurs="0"/>
                                <xs:element name="CheckoutCharge" minOccurs="0" maxOccurs="2">
                                    <xs:complexType>
                                        <xs:attributeGroup ref="tns:CurrencyAmountGroup"/>
                                        <xs:attribute name="Percent" type="tns:Percentage" use="optional"/>
                                        <xs:attribute name="Type" use="optional">
                                            <xs:simpleType>
                                                <xs:restriction base="xs:NMTOKEN">
                                                    <xs:enumeration value="Early"/>
                                                    <xs:enumeration value="Late"/>
                                                </xs:restriction>
                                            </xs:simpleType>
                                        </xs:attribute>
                                        <xs:attributeGroup ref="tns:CodeInfoGroup"/>
                                        <xs:attribute name="NmbrOfNights" type="xs:nonNegativeInteger" use="optional"/>
                                        <xs:attribute name="ExistsCode" type="tns:OTA_CodeType" use="optional"/>
                                        <xs:attribute name="BalanceOfStayInd" type="xs:boolean" use="optional"/>
                                    </xs:complexType>
                                </xs:element>
                            </xs:sequence>
                            <xs:attributeGroup ref="tns:CodeListGroup"/>
                            <xs:attributeGroup ref="tns:DateTimeSpanGroup"/>
                            <xs:attribute name="MaxAdvancedBookingOffset" type="xs:duration" use="optional"/>
                            <xs:attribute name="MinAdvancedBookingOffset" type="xs:duration" use="optional"/>
                            <xs:attribute name="ForceGuaranteeOffset" type="xs:duration" use="optional"/>
                            <xs:attribute name="DepositWaiverOffset" type="xs:duration" use="optional"/>
                            <xs:attribute name="MinTotalOccupancy" type="xs:nonNegativeInteger" use="optional"/>
                            <xs:attribute name="MaxTotalOccupancy" type="xs:nonNegativeInteger" use="optional"/>
                            <xs:attribute name="AbsoluteDropTime" type="tns:DateOrDateTimeType" use="optional"/>
                            <xs:attribute name="GenerallyBookable" type="xs:boolean" use="optional"/>
                            <xs:attribute name="PriceViewable" type="xs:boolean" use="optional"/>
                            <xs:attribute name="QualifiedRateYN" type="xs:boolean" use="optional"/>
                            <xs:attribute name="AddressRequired" type="xs:boolean" use="optional"/>
                            <xs:attributeGroup ref="tns:InvBlockCutoffGroup"/>
                            <xs:attribute name="MaxContiguousBookings" type="xs:nonNegativeInteger" use="optional"/>
                        </xs:complexType>
                    </xs:element>
                </xs:sequence>
            </xs:complexType>
            <xs:attributeGroup name="AgeQualifyingGroup">
                <xs:attribute name="AgeQualifyingCode" type="tns:OTA_CodeType" use="optional"/>
                <xs:attribute name="MinAge" type="tns:Numeric1to999" use="optional"/>
                <xs:attribute name="MaxAge" type="tns:Numeric1to999" use="optional"/>
                <xs:attribute name="AgeTimeUnit" type="tns:TimeUnitType" use="optional"/>
            </xs:attributeGroup>
            <xs:simpleType name="AmountDeterminationType">
                <xs:restriction base="xs:string">
                    <xs:enumeration value="Inclusive"/>
                    <xs:enumeration value="Exclusive"/>
                    <xs:enumeration value="Cumulative"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:attributeGroup name="FeeTaxGroup">
                <xs:attribute name="Type" type="tns:AmountDeterminationType" use="optional"/>
                <xs:attribute name="Code" type="tns:OTA_CodeType" use="optional"/>
                <xs:attribute name="Percent" type="tns:Percentage" use="optional"/>
                <xs:attributeGroup ref="tns:CurrencyAmountGroup"/>
            </xs:attributeGroup>
            <xs:attributeGroup name="ChargeUnitGroup">
                <xs:attribute name="ChargeUnit" type="tns:OTA_CodeType" use="optional"/>
                <xs:attribute name="ChargeFrequency" type="tns:OTA_CodeType" use="optional"/>
                <xs:attribute name="ChargeUnitExempt" type="xs:positiveInteger" use="optional"/>
                <xs:attribute name="ChargeFrequencyExempt" type="xs:positiveInteger" use="optional"/>
                <xs:attribute name="MaxChargeUnitApplies" type="xs:positiveInteger" use="optional"/>
                <xs:attribute name="MaxChargeFrequencyApplies" type="xs:positiveInteger" use="optional"/>
            </xs:attributeGroup>
            <xs:complexType name="FeeType">
                <xs:sequence>
                    <xs:element name="Taxes" type="tns:TaxesType" minOccurs="0"/>
                    <xs:element name="Description" type="tns:ParagraphType" minOccurs="0" maxOccurs="5"/>
                </xs:sequence>
                <xs:attribute name="TaxInclusive" type="xs:boolean"/>
                <xs:attributeGroup ref="tns:FeeTaxGroup"/>
                <xs:attributeGroup ref="tns:EffectiveExpireOptionalDateGroup"/>
                <xs:attribute name="MandatoryIndicator" type="xs:boolean" use="optional"/>
                <xs:attribute name="RPH" type="tns:RPH_Type" use="optional"/>
                <xs:attributeGroup ref="tns:ChargeUnitGroup"/>
                <xs:attribute name="TaxableIndicator" type="xs:boolean" use="optional"/>
            </xs:complexType>
            <xs:complexType name="FeesType">
                <xs:sequence>
                    <xs:element name="Fee" type="tns:FeeType" maxOccurs="unbounded"/>
                </xs:sequence>
            </xs:complexType>
            <xs:simpleType name="ListOfOTA_CodeType">
                <xs:list itemType="tns:OTA_CodeType"/>
            </xs:simpleType>
            <xs:complexType name="HotelAdditionalChargesType">
                <xs:sequence>
                    <xs:element name="AdditionalCharge" maxOccurs="99">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="Amount" type="tns:TotalType" minOccurs="0"/>
                            </xs:sequence>
                            <xs:attribute name="RoomAmenityCode" type="tns:OTA_CodeType" use="optional"/>
                            <xs:attributeGroup ref="tns:QuantityGroup"/>
                        </xs:complexType>
                    </xs:element>
                </xs:sequence>
                <xs:attribute name="AmountBeforeTax" type="tns:Money" use="optional"/>
                <xs:attribute name="AmountAfterTax" type="tns:Money" use="optional"/>
                <xs:attributeGroup ref="tns:CurrencyCodeGroup"/>
            </xs:complexType>
            <xs:attributeGroup name="MealsIncludedGroup">
                <xs:attribute name="Breakfast" type="xs:boolean" use="optional"/>
                <xs:attribute name="Lunch" type="xs:boolean" use="optional"/>
                <xs:attribute name="Dinner" type="xs:boolean" use="optional"/>
                <xs:attribute name="MealPlanIndicator" type="xs:boolean" use="optional"/>
                <xs:attribute name="MealPlanCodes" type="tns:ListOfOTA_CodeType" use="optional"/>
            </xs:attributeGroup>
            <xs:simpleType name="Numeric1to9999">
                <xs:annotation>
                    <xs:documentation xml:lang="en">Used for Numeric values, from 1 to 9999 inclusive.
                    </xs:documentation>
                </xs:annotation>
                <xs:restriction base="xs:integer">
                    <xs:minInclusive value="1"/>
                    <xs:maxInclusive value="9999"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:simpleType name="DayOfWeekType">
                <xs:restriction base="xs:NMTOKEN">
                    <xs:enumeration value="Mon"/>
                    <xs:enumeration value="Tue"/>
                    <xs:enumeration value="Wed"/>
                    <xs:enumeration value="Thu"/>
                    <xs:enumeration value="Fri"/>
                    <xs:enumeration value="Sat"/>
                    <xs:enumeration value="Sun"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:complexType name="RateUploadType">
                <xs:sequence>
                    <xs:element name="BaseByGuestAmts" minOccurs="0">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="BaseByGuestAmt" maxOccurs="unbounded">
                                    <xs:complexType>
                                        <xs:complexContent>
                                            <xs:extension base="tns:TotalType">
                                                <xs:sequence>
                                                    <xs:element name="NumberOfGuestsDescription"
                                                                type="tns:ParagraphType" minOccurs="0" maxOccurs="9"/>
                                                </xs:sequence>
                                                <xs:attribute name="Code" type="tns:StringLength1to16"/>
                                                <xs:attribute name="NumberOfGuests" type="tns:Numeric1to999"
                                                              use="optional"/>
                                                <xs:attributeGroup ref="tns:AgeQualifyingGroup"/>
                                            </xs:extension>
                                        </xs:complexContent>
                                    </xs:complexType>
                                </xs:element>
                            </xs:sequence>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="AdditionalGuestAmounts" minOccurs="0">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="AdditionalGuestAmount" maxOccurs="unbounded">
                                    <xs:complexType>
                                        <xs:sequence>
                                            <xs:element name="Taxes" type="tns:TaxesType" minOccurs="0"/>
                                            <xs:element name="AddlGuestAmtDescription" type="tns:ParagraphType"
                                                        minOccurs="0" maxOccurs="9"/>
                                        </xs:sequence>
                                        <xs:attribute name="TaxInclusive" type="xs:boolean" use="optional"/>
                                        <xs:attribute name="MaxAdditionalGuests" type="tns:Numeric1to999"
                                                      use="optional"/>
                                        <xs:attributeGroup ref="tns:AgeQualifyingGroup"/>
                                        <xs:attributeGroup ref="tns:FeeTaxGroup"/>
                                    </xs:complexType>
                                </xs:element>
                            </xs:sequence>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="Fees" type="tns:FeesType" minOccurs="0"/>
                    <xs:element name="GuaranteePolicies" minOccurs="0">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="GuaranteePolicy" type="tns:GuaranteeType" maxOccurs="unbounded"/>
                            </xs:sequence>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="CancelPolicies" type="tns:CancelPenaltiesType" minOccurs="0"/>
                    <xs:element name="PaymentPolicies" type="tns:RequiredPaymentsType" minOccurs="0"/>
                    <xs:element name="RateDescription" type="tns:ParagraphType" minOccurs="0"/>
                    <xs:element name="UniqueID" type="tns:UniqueID_Type" minOccurs="0"/>
                    <xs:element name="MealsIncluded" minOccurs="0">
                        <xs:complexType>
                            <xs:attributeGroup ref="tns:MealsIncludedGroup"/>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="AdditionalCharges" type="tns:HotelAdditionalChargesType" minOccurs="0"/>
                </xs:sequence>
                <xs:attribute name="NumberOfUnits" type="tns:Numeric1to9999" use="optional"/>
                <xs:attribute name="RateTimeUnit" type="tns:TimeUnitType" use="optional"/>
                <xs:attribute name="UnitMultiplier" type="tns:Numeric1to999" use="optional"/>
                <xs:attribute name="MinGuestApplicable" type="tns:Numeric1to999" use="optional"/>
                <xs:attribute name="MaxGuestApplicable" type="tns:Numeric1to999" use="optional"/>
                <xs:attributeGroup ref="tns:AgeQualifyingGroup"/>
                <xs:attribute name="MinLOS" type="tns:StringLength1to16" use="optional"/>
                <xs:attribute name="MaxLOS" type="tns:StringLength1to16" use="optional"/>
                <xs:attribute name="StayOverDate" type="tns:DayOfWeekType" use="optional"/>
                <xs:attributeGroup ref="tns:DateTimeSpanGroup"/>
                <xs:attributeGroup ref="tns:DOW_PatternGroup"/>
                <xs:attributeGroup ref="tns:CurrencyCodeGroup"/>
                <xs:attribute name="RateTier" type="tns:StringLength1to64" use="optional"/>
            </xs:complexType>
            <xs:attributeGroup name="DerivedRatePlanGroup">
                <xs:attribute name="BaseRatePlanCode" type="tns:StringLength1to64" use="optional"/>
                <xs:attribute name="AdjustedAmount" type="tns:Money" use="optional"/>
                <xs:attribute name="AdjustedPercentage" type="tns:Percentage" use="optional"/>
                <xs:attribute name="FloorAmount" type="tns:Money" use="optional"/>
                <xs:attribute name="CeilingAmount" type="tns:Money" use="optional"/>
                <xs:attribute name="AdjustUpIndicator" type="xs:boolean" use="optional"/>
            </xs:attributeGroup>
            <xs:simpleType name="Numeric1to99">
                <xs:restriction base="xs:integer">
                    <xs:minInclusive value="1"/>
                    <xs:maxInclusive value="99"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:simpleType name="ListOfRPH">
                <xs:list itemType="tns:RPH_Type"/>
            </xs:simpleType>
            <xs:simpleType name="RPH_Type">
                <xs:restriction base="xs:string">
                    <xs:pattern value="[0-9]{1,8}"/>
                </xs:restriction>
            </xs:simpleType>
            <xs:attributeGroup name="OccupancyGroup">
                <xs:attribute name="MinOccupancy" type="tns:Numeric1to99" use="optional"/>
                <xs:attribute name="MaxOccupancy" type="tns:Numeric1to99" use="optional"/>
            </xs:attributeGroup>
            <xs:element name="Occupancy" minOccurs="0" maxOccurs="5">
                <xs:complexType>
                    <xs:attributeGroup ref="tns:OccupancyGroup">
                    </xs:attributeGroup>
                    <xs:attributeGroup ref="tns:AgeQualifyingGroup">
                    </xs:attributeGroup>
                </xs:complexType>
            </xs:element>
            <xs:complexType name="OfferType">
                <xs:sequence>
                    <xs:element name="OfferRules" minOccurs="0">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="OfferRule" maxOccurs="99">
                                    <xs:complexType>
                                        <xs:sequence>
                                            <xs:element name="DateRestriction" minOccurs="0" maxOccurs="5">
                                                <xs:complexType>
                                                    <xs:attributeGroup ref="tns:DateTimeSpanGroup"/>
                                                    <xs:attribute name="RestrictionType" use="optional">
                                                        <xs:simpleType>
                                                            <xs:restriction base="xs:NMTOKEN">
                                                                <xs:enumeration value="arrival"/>
                                                                <xs:enumeration value="departure"/>
                                                                <xs:enumeration value="booking"/>
                                                                <xs:enumeration value="stay"/>
                                                            </xs:restriction>
                                                        </xs:simpleType>
                                                    </xs:attribute>
                                                </xs:complexType>
                                            </xs:element>
                                            <xs:element name="LengthsOfStay" type="tns:LengthsOfStayType"
                                                        minOccurs="0"/>
                                            <xs:element name="DOW_Restrictions" type="tns:DOW_RestrictionsType"
                                                        minOccurs="0"/>
                                            <xs:element name="Occupancy" minOccurs="0" maxOccurs="5">
                                                <xs:complexType>
                                                    <xs:attributeGroup ref="tns:OccupancyGroup"/>
                                                    <xs:attributeGroup ref="tns:AgeQualifyingGroup"/>
                                                </xs:complexType>
                                            </xs:element>
                                            <xs:element name="Inventories" minOccurs="0">
                                                <xs:complexType>
                                                    <xs:sequence>
                                                        <xs:element name="Inventory" maxOccurs="99">
                                                            <xs:complexType>
                                                                <xs:attributeGroup ref="tns:InventoryGroup"/>
                                                                <xs:attribute name="AppliesToIndicator"
                                                                              type="xs:boolean" use="required"/>
                                                            </xs:complexType>
                                                        </xs:element>
                                                    </xs:sequence>
                                                </xs:complexType>
                                            </xs:element>
                                        </xs:sequence>
                                        <xs:attribute name="StayOverDate" type="tns:DayOfWeekType" use="optional"/>
                                        <xs:attribute name="MinTotalOccupancy" type="xs:nonNegativeInteger"
                                                      use="optional"/>
                                        <xs:attribute name="MaxTotalOccupancy" type="xs:nonNegativeInteger"
                                                      use="optional"/>
                                        <xs:attribute name="MaxContiguousBookings" type="xs:nonNegativeInteger"
                                                      use="optional"/>
                                        <xs:attribute name="MaxAdvancedBookingOffset" type="xs:duration"
                                                      use="optional"/>
                                        <xs:attribute name="MinAdvancedBookingOffset" type="xs:duration"
                                                      use="optional"/>
                                    </xs:complexType>
                                </xs:element>
                            </xs:sequence>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="Discount" minOccurs="0">
                        <xs:complexType>
                            <xs:attribute name="NightsRequired" type="xs:nonNegativeInteger" use="optional"/>
                            <xs:attribute name="NightsDiscounted" type="xs:nonNegativeInteger" use="optional"/>
                            <xs:attribute name="DiscountPattern" type="tns:StringLength1to32" use="optional"/>
                            <xs:attributeGroup ref="tns:CurrencyAmountGroup"/>
                            <xs:attribute name="Percent" type="tns:Percentage" use="optional"/>
                            <xs:attribute name="ChargeUnitCode" type="tns:OTA_CodeType" use="optional"/>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="FreeUpgrade" minOccurs="0">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="UpgradeFrom" minOccurs="0">
                                    <xs:complexType>
                                        <xs:attributeGroup ref="tns:InventoryGroup"/>
                                    </xs:complexType>
                                </xs:element>
                                <xs:element name="UpgradeTo" minOccurs="0">
                                    <xs:complexType>
                                        <xs:attributeGroup ref="tns:InventoryGroup"/>
                                    </xs:complexType>
                                </xs:element>
                            </xs:sequence>
                            <xs:attribute name="UpgradeBookingCode" type="tns:StringLength1to16" use="optional"/>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="OfferDescription" type="tns:ParagraphType" minOccurs="0"/>
                    <xs:element name="CompatibleOffers" minOccurs="0">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="CompatibleOffer" maxOccurs="99">
                                    <xs:complexType>
                                        <xs:attribute name="OfferRPH" type="tns:ListOfRPH" use="optional"/>
                                        <xs:attribute name="IncompatibleOfferIndicator" type="xs:boolean"
                                                      use="optional"/>
                                    </xs:complexType>
                                </xs:element>
                            </xs:sequence>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="Inventories" minOccurs="0">
                        <xs:annotation>
                            <xs:documentation xml:lang="en">Collection of inventory.</xs:documentation>
                        </xs:annotation>
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="Inventory" maxOccurs="99">
                                    <xs:complexType>
                                        <xs:attributeGroup ref="tns:InventoryGroup"/>
                                        <xs:attribute name="AppliesToIndicator" type="xs:boolean" use="required"/>
                                    </xs:complexType>
                                </xs:element>
                            </xs:sequence>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="Guests" minOccurs="0">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="Guest" maxOccurs="9">
                                    <xs:complexType>
                                        <xs:attributeGroup ref="tns:AgeQualifyingGroup"/>
                                        <xs:attribute name="MinCount" type="xs:nonNegativeInteger" use="optional"/>
                                        <xs:attribute name="MaxCount" type="xs:nonNegativeInteger" use="optional"/>
                                        <xs:attribute name="FirstQualifyingPosition" type="xs:nonNegativeInteger"
                                                      use="optional"/>
                                        <xs:attribute name="LastQualifyingPosition" type="xs:nonNegativeInteger"
                                                      use="optional"/>
                                    </xs:complexType>
                                </xs:element>
                            </xs:sequence>
                        </xs:complexType>
                    </xs:element>
                </xs:sequence>
                <xs:attribute name="OfferCode" type="tns:StringLength1to16" use="optional"/>
                <xs:attribute name="RPH" type="tns:RPH_Type" use="optional"/>
                <xs:attribute name="ApplicationOrder" type="xs:integer" use="optional"/>
            </xs:complexType>
            <xs:attributeGroup name="RoomGroup">
                <xs:attribute name="RoomType" type="tns:StringLength1to16" use="optional"/>
                <xs:attribute name="RoomTypeCode" type="tns:StringLength1to16" use="optional"/>
                <xs:attribute name="RoomCategory" type="tns:OTA_CodeType" use="optional"/>
                <xs:attribute name="RoomID" type="tns:StringLength1to16" use="optional"/>
                <xs:attribute name="Floor" type="tns:Numeric1to999" use="optional"/>
                <xs:attribute name="InvBlockCode" type="tns:StringLength1to32" use="optional"/>
                <xs:attributeGroup ref="tns:PromotionCodeGroup"/>
                <xs:attribute name="RoomLocationCode" type="tns:OTA_CodeType" use="optional"/>
                <xs:attribute name="RoomViewCode" type="tns:OTA_CodeType" use="optional"/>
                <xs:attribute name="BedTypeCode" type="tns:ListOfOTA_CodeType" use="optional"/>
                <xs:attribute name="NonSmoking" type="xs:boolean" use="optional"/>
                <xs:attribute name="Configuration" type="xs:string" use="optional"/>
                <xs:attribute name="SizeMeasurement" type="xs:string" use="optional"/>
                <xs:attribute name="Quantity" type="tns:Numeric1to999" use="optional"/>
                <xs:attribute name="Composite" type="xs:boolean" use="optional"/>
                <xs:attribute name="RoomClassificationCode" type="tns:OTA_CodeType" use="optional"/>
                <xs:attribute name="RoomArchitectureCode" type="tns:OTA_CodeType" use="optional"/>
            </xs:attributeGroup>
            <xs:complexType name="AdditionalGuestAmountType">
                <xs:sequence>
                    <xs:element name="Amount" type="tns:TotalType"/>
                    <xs:element name="AddlGuestAmtDescription" type="tns:ParagraphType" minOccurs="0" maxOccurs="9"/>
                </xs:sequence>
                <xs:attribute name="MaxAdditionalGuests" type="tns:Numeric1to999"/>
                <xs:attributeGroup ref="tns:AgeQualifyingGroup"/>
                <xs:attribute name="Type" type="tns:OTA_CodeType" use="optional"/>
                <xs:attribute name="Percent" type="tns:Percentage" use="optional"/>
                <xs:attribute name="RPH" type="tns:RPH_Type" use="optional"/>
            </xs:complexType>
            <xs:complexType name="GuestRoomType">
                <xs:sequence>
                    <xs:element name="Quantities" minOccurs="0">
                        <xs:complexType>
                            <xs:attribute name="MaxRollaways" type="xs:nonNegativeInteger" use="optional"/>
                            <xs:attribute name="StandardNumBeds" type="xs:nonNegativeInteger" use="optional"/>
                            <xs:attribute name="MaximumAdditionalGuests" type="xs:nonNegativeInteger" use="optional"/>
                            <xs:attribute name="MinBillableGuests" type="xs:nonNegativeInteger" use="optional"/>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="Occupancy" minOccurs="0" maxOccurs="5">
                        <xs:complexType>
                            <xs:attributeGroup ref="tns:OccupancyGroup"/>
                            <xs:attributeGroup ref="tns:AgeQualifyingGroup"/>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="Room" minOccurs="0">
                        <xs:complexType>
                            <xs:attributeGroup ref="tns:RoomGroup"/>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="Amenities" minOccurs="0">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="Amenity" maxOccurs="unbounded">
                                    <xs:complexType>
                                        <xs:attribute name="AmenityCode" type="tns:OTA_CodeType"/>
                                    </xs:complexType>
                                </xs:element>
                            </xs:sequence>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="RoomLevelFees" minOccurs="0">
                        <xs:complexType>
                            <xs:complexContent>
                                <xs:extension base="tns:FeesType">
                                    <xs:attributeGroup ref="tns:CodeListGroup"/>
                                </xs:extension>
                            </xs:complexContent>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="AdditionalGuestAmount" type="tns:AdditionalGuestAmountType" minOccurs="0"
                                maxOccurs="5"/>
                    <xs:element name="Description" type="tns:ParagraphType" minOccurs="0"/>
                </xs:sequence>
            </xs:complexType>
            <xs:simpleType name="DateOrMonthDay">
                <xs:union memberTypes="xs:date xs:gMonthDay"/>
            </xs:simpleType>
            <xs:attributeGroup name="MultimediaDescriptionGroup">
                <xs:attribute name="ContentID" type="tns:StringLength1to64" use="optional"/>
                <xs:attribute name="Title" type="tns:StringLength1to64" use="optional"/>
                <xs:attribute name="Author" type="tns:StringLength1to64" use="optional"/>
                <xs:attribute name="CopyrightNotice" type="tns:StringLength1to64" use="optional"/>
                <xs:attribute name="CopyrightOwner" type="tns:StringLength1to64" use="optional"/>
                <xs:attribute name="CopyrightStart" type="tns:DateOrDateTimeType" use="optional"/>
                <xs:attribute name="CopyrightEnd" type="tns:DateOrDateTimeType" use="optional"/>
                <xs:attribute name="EffectiveStart" type="tns:DateOrDateTimeType" use="optional"/>
                <xs:attribute name="EffectiveEnd" type="tns:DateOrDateTimeType" use="optional"/>
                <xs:attribute name="ApplicableStart" type="tns:DateOrMonthDay" use="optional"/>
                <xs:attribute name="ApplicableEnd" type="tns:DateOrMonthDay" use="optional"/>
                <xs:attribute name="RecordID" type="tns:StringLength1to32" use="optional"/>
                <xs:attribute name="SourceID" type="tns:StringLength1to32" use="optional"/>
            </xs:attributeGroup>
            <xs:attributeGroup name="MultimediaItemGroup">
                <xs:attribute name="Language" type="xs:language" use="optional"/>
                <xs:attribute name="Format" type="tns:OTA_CodeType" use="optional"/>
                <xs:attribute name="FileSize" type="xs:positiveInteger" use="optional"/>
                <xs:attribute name="FileName" type="tns:StringLength1to64" use="optional"/>
            </xs:attributeGroup>
            <xs:complexType name="VideoItemType">
                <xs:annotation>
                    <xs:documentation xml:lang="en">Details for a video of a given category.</xs:documentation>
                </xs:annotation>
                <xs:sequence>
                    <xs:element name="URL" type="xs:anyURI" minOccurs="0"/>
                </xs:sequence>
                <xs:attribute name="UnitOfMeasureCode" type="tns:OTA_CodeType" use="optional"/>
                <xs:attribute name="Width" type="xs:positiveInteger" use="optional"/>
                <xs:attribute name="Height" type="xs:positiveInteger" use="optional"/>
                <xs:attribute name="BitRate" type="xs:positiveInteger" use="optional"/>
                <xs:attribute name="Length" type="xs:positiveInteger" use="optional"/>
                <xs:attributeGroup ref="tns:MultimediaItemGroup"/>
            </xs:complexType>
            <xs:complexType name="VideoDescriptionType">
                <xs:sequence>
                    <xs:element name="VideoFormat" minOccurs="0" maxOccurs="unbounded">
                        <xs:complexType>
                            <xs:complexContent>
                                <xs:extension base="tns:VideoItemType">
                                    <xs:attributeGroup ref="tns:MultimediaDescriptionGroup"/>
                                    <xs:attributeGroup ref="tns:ID_OptionalGroup"/>
                                </xs:extension>
                            </xs:complexContent>
                        </xs:complexType>
                    </xs:element>
                </xs:sequence>
                <xs:attribute name="Category" type="tns:OTA_CodeType" use="optional"/>
            </xs:complexType>
            <xs:attributeGroup name="DateTimeStampGroup">
                <xs:attribute name="CreateDateTime" type="xs:dateTime" use="optional"/>
                <xs:attribute name="CreatorID" type="tns:StringLength1to32" use="optional"/>
                <xs:attribute name="LastModifyDateTime" type="xs:dateTime" use="optional"/>
                <xs:attribute name="LastModifierID" type="tns:StringLength1to32" use="optional"/>
                <xs:attribute name="PurgeDate" type="xs:date" use="optional"/>
            </xs:attributeGroup>
            <xs:complexType name="VideoItemsType">
                <xs:sequence>
                    <xs:element name="VideoItem" maxOccurs="unbounded">
                        <xs:complexType>
                            <xs:complexContent>
                                <xs:extension base="tns:VideoDescriptionType">
                                    <xs:attribute name="Language" type="xs:language" use="optional"/>
                                    <xs:attribute name="Caption" type="tns:StringLength1to128" use="optional"/>
                                    <xs:attributeGroup ref="tns:RemovalGroup"/>
                                    <xs:attribute name="Version" type="xs:string" use="optional"/>
                                    <xs:attributeGroup ref="tns:DateTimeStampGroup"/>
                                </xs:extension>
                            </xs:complexContent>
                        </xs:complexType>
                    </xs:element>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="ImageItemType">
                <xs:sequence>
                    <xs:element name="URL" type="xs:anyURI" minOccurs="0"/>
                </xs:sequence>
                <xs:attribute name="UnitOfMeasureCode" type="tns:OTA_CodeType" use="optional"/>
                <xs:attribute name="Width" type="xs:positiveInteger" use="optional"/>
                <xs:attribute name="Height" type="xs:positiveInteger" use="optional"/>
            </xs:complexType>
            <xs:attributeGroup name="LanguageGroup">
                <xs:attribute name="Language" type="xs:language" use="optional"/>
            </xs:attributeGroup>
            <xs:complexType name="FormattedTextTextType">
                <xs:simpleContent>
                    <xs:extension base="xs:string">
                        <xs:attribute name="Formatted" type="xs:boolean" use="optional"/>
                        <xs:attributeGroup ref="tns:LanguageGroup"/>
                        <xs:attribute name="TextFormat" use="optional">
                            <xs:simpleType>
                                <xs:restriction base="xs:NMTOKEN">
                                    <xs:enumeration value="PlainText"/>
                                    <xs:enumeration value="HTML"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:attribute>
                    </xs:extension>
                </xs:simpleContent>
            </xs:complexType>
            <xs:complexType name="TextDescriptionType">
                <xs:choice>
                    <xs:element name="URL" type="xs:anyURI" minOccurs="0"/>
                    <xs:element name="Description" minOccurs="0" maxOccurs="unbounded">
                        <xs:complexType>
                            <xs:simpleContent>
                                <xs:extension base="tns:FormattedTextTextType">
                                    <xs:attribute name="ListItem" type="xs:integer" use="optional"/>
                                </xs:extension>
                            </xs:simpleContent>
                        </xs:complexType>
                    </xs:element>
                </xs:choice>
                <xs:attribute name="Category" type="tns:OTA_CodeType" use="optional"/>
                <xs:attributeGroup ref="tns:MultimediaDescriptionGroup"/>
                <xs:attribute name="Language" type="xs:language" use="optional"/>
            </xs:complexType>
            <xs:complexType name="TextItemsType">
                <xs:sequence>
                    <xs:element name="TextItem" maxOccurs="unbounded">
                        <xs:complexType>
                            <xs:complexContent>
                                <xs:extension base="tns:TextDescriptionType">
                                    <xs:attributeGroup ref="tns:DateTimeStampGroup"/>
                                    <xs:attributeGroup ref="tns:RemovalGroup"/>
                                    <xs:attribute name="Version" type="xs:string" use="optional"/>
                                </xs:extension>
                            </xs:complexContent>
                        </xs:complexType>
                    </xs:element>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="ImageDescriptionType">
                <xs:sequence>
                    <xs:element name="ImageFormat" minOccurs="0" maxOccurs="unbounded">
                        <xs:complexType>
                            <xs:complexContent>
                                <xs:extension base="tns:ImageItemType">
                                    <xs:attributeGroup ref="tns:MultimediaDescriptionGroup"/>
                                    <xs:attribute name="Language" type="xs:language" use="optional"/>
                                    <xs:attribute name="Format" type="tns:OTA_CodeType" use="optional"/>
                                    <xs:attribute name="FileName" type="tns:StringLength1to64" use="optional"/>
                                    <xs:attribute name="FileSize" type="xs:positiveInteger" use="optional"/>
                                    <xs:attribute name="DimensionCategory" type="tns:StringLength1to16" use="optional"/>
                                    <xs:attribute name="IsOriginalIndicator" type="xs:boolean" use="optional"/>
                                </xs:extension>
                            </xs:complexContent>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="Description" minOccurs="0" maxOccurs="unbounded">
                        <xs:complexType>
                            <xs:simpleContent>
                                <xs:extension base="tns:FormattedTextTextType">
                                    <xs:attribute name="Caption" type="tns:StringLength1to128" use="optional"/>
                                </xs:extension>
                            </xs:simpleContent>
                        </xs:complexType>
                    </xs:element>
                </xs:sequence>
                <xs:attribute name="Category" type="tns:OTA_CodeType" use="optional"/>
            </xs:complexType>
            <xs:complexType name="ImageItemsType">
                <xs:sequence>
                    <xs:element name="ImageItem" maxOccurs="unbounded">
                        <xs:complexType>
                            <xs:complexContent>
                                <xs:extension base="tns:ImageDescriptionType">
                                    <xs:attributeGroup ref="tns:DateTimeStampGroup"/>
                                    <xs:attributeGroup ref="tns:RemovalGroup"/>
                                    <xs:attribute name="Version" type="xs:string" use="optional"/>
                                    <xs:attributeGroup ref="tns:ID_OptionalGroup"/>
                                </xs:extension>
                            </xs:complexContent>
                        </xs:complexType>
                    </xs:element>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="MultimediaDescriptionType">
                <xs:choice minOccurs="0">
                    <xs:element name="VideoItems" type="tns:VideoItemsType" minOccurs="0"/>
                    <xs:element name="ImageItems" type="tns:ImageItemsType" minOccurs="0"/>
                    <xs:element name="TextItems" type="tns:TextItemsType" minOccurs="0"/>
                </xs:choice>
                <xs:attribute name="InfoCode" type="tns:OTA_CodeType" use="optional"/>
                <xs:attribute name="AdditionalDetailCode" type="tns:OTA_CodeType" use="optional"/>
                <xs:attributeGroup ref="tns:ID_OptionalGroup"/>
                <xs:attribute name="LastUpdated" type="xs:dateTime" use="optional"/>
                <xs:attribute name="Version" type="xs:string" use="optional"/>
            </xs:complexType>
            <xs:complexType name="MultimediaDescriptionsType">
                <xs:sequence>
                    <xs:element name="MultimediaDescription" type="tns:MultimediaDescriptionType"
                                maxOccurs="unbounded"/>
                </xs:sequence>
                <xs:attribute name="LastUpdated" type="xs:dateTime" use="optional"/>
            </xs:complexType>
            <xs:complexType name="MeetingRoomCodeType">
                <xs:sequence>
                    <xs:element name="Charge" type="tns:FeeType" minOccurs="0"/>
                    <xs:element name="MultimediaDescriptions" type="tns:MultimediaDescriptionsType" minOccurs="0"/>
                </xs:sequence>
                <xs:attribute name="Code" type="tns:OTA_CodeType" use="optional"/>
                <xs:attribute name="ExistsCode" type="tns:OTA_CodeType" use="optional"/>
                <xs:attributeGroup ref="tns:CodeInfoGroup"/>
                <xs:attributeGroup ref="tns:QuantityGroup"/>
                <xs:attribute name="DiscountsAvailableCode" type="tns:OTA_CodeType" use="optional"/>
                <xs:attributeGroup ref="tns:ID_OptionalGroup"/>
            </xs:complexType>
            <xs:attributeGroup name="DimensionGroup">
                <xs:attribute name="Area" type="xs:decimal" use="optional"/>
                <xs:attribute name="Height" type="xs:decimal" use="optional"/>
                <xs:attribute name="Length" type="xs:decimal" use="optional"/>
                <xs:attribute name="Width" type="xs:decimal" use="optional"/>
                <xs:attribute name="Units" type="tns:StringLength1to16" use="optional"/>
                <xs:attribute name="UnitOfMeasureCode" type="tns:OTA_CodeType" use="optional"/>
            </xs:attributeGroup>
            <xs:complexType name="MeetingRoomCapacityType">
                <xs:sequence>
                    <xs:element name="Occupancy" minOccurs="0">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="MinRoomCharge" type="tns:FeeType" minOccurs="0"/>
                            </xs:sequence>
                            <xs:attribute name="MinOccupancy" type="xs:nonNegativeInteger" use="optional"/>
                            <xs:attribute name="MaxOccupancy" type="xs:nonNegativeInteger" use="optional"/>
                            <xs:attribute name="StandardOccupancy" type="xs:nonNegativeInteger" use="optional"/>
                        </xs:complexType>
                    </xs:element>
                </xs:sequence>
                <xs:attribute name="MeetingRoomFormatCode" type="tns:OTA_CodeType"/>
            </xs:complexType>
            <xs:complexType name="FeaturesType">
                <xs:sequence>
                    <xs:element name="Feature" maxOccurs="unbounded">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="Charge" minOccurs="0">
                                    <xs:complexType>
                                        <xs:attributeGroup ref="tns:CurrencyAmountGroup"/>
                                    </xs:complexType>
                                </xs:element>
                                <xs:element name="MultimediaDescriptions" type="tns:MultimediaDescriptionsType"
                                            minOccurs="0"/>
                                <xs:element name="DescriptiveText" minOccurs="0">
                                    <xs:simpleType>
                                        <xs:restriction base="xs:string">
                                            <xs:pattern value="[A-Za-z0-9]{1,500}"/>
                                        </xs:restriction>
                                    </xs:simpleType>
                                </xs:element>
                            </xs:sequence>
                            <xs:attributeGroup ref="tns:CodeInfoGroup"/>
                            <xs:attribute name="AccessibleCode" type="tns:OTA_CodeType" use="optional"/>
                            <xs:attribute name="SecurityCode" type="tns:OTA_CodeType" use="optional"/>
                            <xs:attribute name="ExistsCode" type="tns:OTA_CodeType" use="optional"/>
                            <xs:attribute name="ProximityCode" type="tns:OTA_CodeType" use="optional"/>
                            <xs:attributeGroup ref="tns:ID_OptionalGroup"/>
                        </xs:complexType>
                    </xs:element>
                </xs:sequence>
            </xs:complexType>
            <xs:attributeGroup name="UnitsOfMeasureGroup">
                <xs:attribute name="UnitOfMeasureQuantity" type="xs:decimal" use="optional"/>
                <xs:attribute name="UnitOfMeasure" type="tns:StringLength1to16" use="optional"/>
                <xs:attribute name="UnitOfMeasureCode" type="tns:OTA_CodeType" use="optional"/>
            </xs:attributeGroup>
            <xs:complexType name="MeetingRoomsType">
                <xs:sequence>
                    <xs:element name="MeetingRoom" minOccurs="0" maxOccurs="unbounded">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="Codes" minOccurs="0">
                                    <xs:complexType>
                                        <xs:sequence>
                                            <xs:element name="Code" type="tns:MeetingRoomCodeType"
                                                        maxOccurs="unbounded"/>
                                        </xs:sequence>
                                    </xs:complexType>
                                </xs:element>
                                <xs:element name="Dimension" minOccurs="0">
                                    <xs:complexType>
                                        <xs:attributeGroup ref="tns:DimensionGroup"/>
                                    </xs:complexType>
                                </xs:element>
                                <xs:element name="AvailableCapacities" minOccurs="0">
                                    <xs:complexType>
                                        <xs:sequence>
                                            <xs:element name="MeetingRoomCapacity" type="tns:MeetingRoomCapacityType"
                                                        maxOccurs="unbounded"/>
                                        </xs:sequence>
                                    </xs:complexType>
                                </xs:element>
                                <xs:element name="Features" type="tns:FeaturesType" minOccurs="0"/>
                                <xs:element name="MultimediaDescriptions" type="tns:MultimediaDescriptionsType"
                                            minOccurs="0"/>
                            </xs:sequence>
                            <xs:attribute name="Irregular" type="xs:boolean" use="optional"/>
                            <xs:attribute name="PropertySystemName" type="xs:string" use="optional"/>
                            <xs:attribute name="RoomName" type="xs:string" use="optional"/>
                            <xs:attribute name="Sort" type="xs:nonNegativeInteger" use="optional"/>
                            <xs:attribute name="MeetingRoomCapacity" type="xs:nonNegativeInteger" use="optional"/>
                            <xs:attributeGroup ref="tns:RemovalGroup"/>
                            <xs:attributeGroup ref="tns:ID_OptionalGroup"/>
                            <xs:attribute name="Access" type="xs:string" use="optional"/>
                            <xs:attribute name="MeetingRoomTypeCode" type="tns:OTA_CodeType" use="optional"/>
                            <xs:attribute name="MeetingRoomLevel" type="tns:StringLength1to64" use="optional"/>
                            <xs:attribute name="DedicatedIndicator" type="xs:boolean" use="optional"/>
                        </xs:complexType>
                    </xs:element>
                </xs:sequence>
                <xs:attribute name="MeetingRoomCount" type="xs:nonNegativeInteger" use="optional"/>
                <xs:attribute name="SmallestRoomSpace" type="xs:nonNegativeInteger" use="optional"/>
                <xs:attribute name="LargestRoomSpace" type="xs:nonNegativeInteger" use="optional"/>
                <xs:attributeGroup ref="tns:UnitsOfMeasureGroup"/>
                <xs:attribute name="TotalRoomSpace" type="xs:nonNegativeInteger" use="optional"/>
                <xs:attribute name="LargestSeatingCapacity" type="xs:nonNegativeInteger" use="optional"/>
                <xs:attribute name="SecondLargestSeatingCapacity" type="xs:nonNegativeInteger" use="optional"/>
                <xs:attribute name="SmallestSeatingCapacity" type="xs:nonNegativeInteger" use="optional"/>
                <xs:attribute name="TotalRoomSeatingCapacity" type="xs:nonNegativeInteger" use="optional"/>
                <xs:attribute name="LargestRoomHeight" type="xs:nonNegativeInteger" use="optional"/>
            </xs:complexType>
            <xs:complexType name="MeetingRoomsType">
                <xs:sequence>
                    <xs:element name="MeetingRoom" minOccurs="0" maxOccurs="unbounded">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="Codes" minOccurs="0">
                                    <xs:complexType>
                                        <xs:sequence>
                                            <xs:element name="Code" type="tns:MeetingRoomCodeType"
                                                        maxOccurs="unbounded"/>
                                        </xs:sequence>
                                    </xs:complexType>
                                </xs:element>
                                <xs:element name="Dimension" minOccurs="0">
                                    <xs:complexType>
                                        <xs:attributeGroup ref="tns:DimensionGroup"/>
                                    </xs:complexType>
                                </xs:element>
                                <xs:element name="AvailableCapacities" minOccurs="0">
                                    <xs:complexType>
                                        <xs:sequence>
                                            <xs:element name="MeetingRoomCapacity" type="tns:MeetingRoomCapacityType"
                                                        maxOccurs="unbounded"/>
                                        </xs:sequence>
                                    </xs:complexType>
                                </xs:element>
                                <xs:element name="Features" type="tns:FeaturesType" minOccurs="0"/>
                                <xs:element name="MultimediaDescriptions" type="tns:MultimediaDescriptionsType"
                                            minOccurs="0"/>
                            </xs:sequence>
                            <xs:attribute name="Irregular" type="xs:boolean" use="optional"/>
                            <xs:attribute name="PropertySystemName" type="xs:string" use="optional"/>
                            <xs:attribute name="RoomName" type="xs:string" use="optional"/>
                            <xs:attribute name="Sort" type="xs:nonNegativeInteger" use="optional"/>
                            <xs:attribute name="MeetingRoomCapacity" type="xs:nonNegativeInteger" use="optional"/>
                            <xs:attributeGroup ref="tns:RemovalGroup"/>
                            <xs:attributeGroup ref="tns:ID_OptionalGroup"/>
                            <xs:attribute name="Access" type="xs:string" use="optional"/>
                            <xs:attribute name="MeetingRoomTypeCode" type="tns:OTA_CodeType" use="optional"/>
                            <xs:attribute name="MeetingRoomLevel" type="tns:StringLength1to64" use="optional"/>
                            <xs:attribute name="DedicatedIndicator" type="xs:boolean" use="optional"/>
                        </xs:complexType>
                    </xs:element>
                </xs:sequence>
                <xs:attribute name="MeetingRoomCount" type="xs:nonNegativeInteger" use="optional"/>
                <xs:attribute name="SmallestRoomSpace" type="xs:nonNegativeInteger" use="optional"/>
                <xs:attribute name="LargestRoomSpace" type="xs:nonNegativeInteger" use="optional"/>
                <xs:attributeGroup ref="tns:UnitsOfMeasureGroup"/>
                <xs:attribute name="TotalRoomSpace" type="xs:nonNegativeInteger" use="optional"/>
                <xs:attribute name="LargestSeatingCapacity" type="xs:nonNegativeInteger" use="optional"/>
                <xs:attribute name="SecondLargestSeatingCapacity" type="xs:nonNegativeInteger" use="optional"/>
                <xs:attribute name="SmallestSeatingCapacity" type="xs:nonNegativeInteger" use="optional"/>
                <xs:attribute name="TotalRoomSeatingCapacity" type="xs:nonNegativeInteger" use="optional"/>
                <xs:attribute name="LargestRoomHeight" type="xs:nonNegativeInteger" use="optional"/>
            </xs:complexType>
            <xs:attributeGroup name="InvBlockCodeGroup">
                <xs:attribute name="Code" type="tns:StringLength1to16"/>
            </xs:attributeGroup>
            <xs:complexType name="SellableProductsType">
                <xs:sequence>
                    <xs:element name="SellableProduct" maxOccurs="unbounded">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="DestinationSystemCodes" minOccurs="0">
                                    <xs:complexType>
                                        <xs:sequence>
                                            <xs:element name="DestinationSystemCode" maxOccurs="unbounded">
                                                <xs:complexType>
                                                    <xs:simpleContent>
                                                        <xs:extension base="tns:StringLength1to32">
                                                            <xs:attribute name="ChainRateLevelCrossRef"
                                                                          type="tns:StringLength1to64" use="optional"/>
                                                            <xs:attribute name="ChainRateCodeCrossRef"
                                                                          type="tns:StringLength1to64" use="optional"/>
                                                        </xs:extension>
                                                    </xs:simpleContent>
                                                </xs:complexType>
                                            </xs:element>
                                        </xs:sequence>
                                    </xs:complexType>
                                </xs:element>
                                <xs:choice>
                                    <xs:element name="GuestRoom" type="tns:GuestRoomType"/>
                                    <xs:element name="MeetingRooms" type="tns:MeetingRoomsType"/>
                                    <xs:element name="InventoryBlock">
                                        <xs:complexType>
                                            <xs:attributeGroup ref="tns:InvBlockCodeGroup"/>
                                        </xs:complexType>
                                    </xs:element>
                                </xs:choice>
                                <xs:element name="Description" type="tns:ParagraphType" minOccurs="0"/>
                                <xs:element name="UniqueID" type="tns:UniqueID_Type" minOccurs="0"/>
                            </xs:sequence>
                            <xs:attribute name="RPH" type="tns:RPH_Type" use="optional"/>
                            <xs:attributeGroup ref="tns:InventoryGroup"/>
                            <xs:attribute name="InvNotifType" use="optional">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="New"/>
                                        <xs:enumeration value="Delta"/>
                                        <xs:enumeration value="Overlay"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:attribute>
                            <xs:attribute name="InvStatusType" use="optional">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="Initial"/>
                                        <xs:enumeration value="Active"/>
                                        <xs:enumeration value="Deactivated"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:attribute>
                            <xs:attribute name="InvGroupingCode" type="xs:string" use="optional"/>
                            <xs:attribute name="OrderSequence" type="tns:Numeric1to999" use="optional"/>
                            <xs:attributeGroup ref="tns:DateTimeSpanGroup"/>
                        </xs:complexType>
                    </xs:element>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="CommissionType">
                <xs:sequence>
                    <xs:element name="UniqueID" type="tns:UniqueID_Type" minOccurs="0"/>
                    <xs:element name="CommissionableAmount" minOccurs="0">
                        <xs:complexType>
                            <xs:attributeGroup ref="tns:CurrencyAmountGroup"/>
                            <xs:attribute name="TaxInclusiveIndicator" type="xs:boolean" use="optional"/>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="PrepaidAmount" minOccurs="0">
                        <xs:complexType>
                            <xs:attributeGroup ref="tns:CurrencyAmountGroup"/>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="FlatCommission" minOccurs="0">
                        <xs:complexType>
                            <xs:attributeGroup ref="tns:CurrencyAmountGroup"/>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="CommissionPayableAmount" minOccurs="0">
                        <xs:complexType>
                            <xs:attributeGroup ref="tns:CurrencyAmountGroup"/>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="Comment" type="tns:ParagraphType" minOccurs="0"/>
                </xs:sequence>
                <xs:attribute name="StatusType" use="optional">
                    <xs:simpleType>
                        <xs:restriction base="xs:NMTOKEN">
                            <xs:enumeration value="Full"/>
                            <xs:enumeration value="Partial"/>
                            <xs:enumeration value="Non-paying"/>
                            <xs:enumeration value="No-show"/>
                            <xs:enumeration value="Adjustment"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
                <xs:attribute name="Percent" type="tns:Percentage" use="optional"/>
                <xs:attributeGroup ref="tns:CurrencyCodeGroup"/>
                <xs:attribute name="ReasonCode" type="tns:StringLength1to8" use="optional"/>
                <xs:attribute name="BillToID" type="tns:StringLength1to8" use="optional"/>
                <xs:attribute name="Frequency" type="tns:OTA_CodeType" use="optional"/>
                <xs:attribute name="MaxCommissionUnitApplies" type="xs:positiveInteger" use="optional"/>
                <xs:attribute name="CapAmount" type="tns:Money" use="optional"/>
            </xs:complexType>
            <xs:complexType name="HotelRatePlanType">
                <xs:sequence>
                    <xs:element name="DestinationSystemsCode" minOccurs="0">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="DestinationSystemCode" maxOccurs="unbounded">
                                    <xs:complexType>
                                        <xs:simpleContent>
                                            <xs:extension base="tns:StringLength1to32">
                                                <xs:attribute name="ChainRateLevelCrossRef" type="tns:StringLength1to64"
                                                              use="optional"/>
                                                <xs:attribute name="ChainRateCodeCrossRef" type="tns:StringLength1to64"
                                                              use="optional"/>
                                                <xs:attribute name="LengthOfStayRuleID" type="tns:StringLength1to64"
                                                              use="optional"/>
                                                <xs:attribute name="POS_RuleID" type="tns:StringLength1to64"
                                                              use="optional"/>
                                                <xs:attribute name="RateAccessID" type="tns:StringLength1to64"
                                                              use="optional"/>
                                                <xs:attribute name="GuaranteeDepositRuleID" type="tns:StringLength1to64"
                                                              use="optional"/>
                                                <xs:attribute name="CancelRuleID" type="tns:StringLength1to64"
                                                              use="optional"/>
                                            </xs:extension>
                                        </xs:simpleContent>
                                    </xs:complexType>
                                </xs:element>
                            </xs:sequence>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="BookingRules" minOccurs="0">
                        <xs:complexType>
                            <xs:complexContent>
                                <xs:extension base="tns:BookingRulesType">
                                    <xs:sequence>
                                        <xs:element name="InventoryInfo" minOccurs="0">
                                            <xs:complexType>
                                                <xs:attributeGroup ref="tns:InventoryGroup"/>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:extension>
                            </xs:complexContent>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="Rates" minOccurs="0">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="Rate" maxOccurs="unbounded">
                                    <xs:complexType>
                                        <xs:complexContent>
                                            <xs:extension base="tns:RateUploadType">
                                                <xs:attributeGroup ref="tns:InventoryGroup"/>
                                                <xs:attribute name="Status" type="tns:AvailabilityStatusType"
                                                              use="optional"/>
                                                <xs:attribute name="ExtraNightIndicator" type="xs:boolean"
                                                              use="optional"/>
                                                <xs:attributeGroup ref="tns:DerivedRatePlanGroup"/>
                                            </xs:extension>
                                        </xs:complexContent>
                                    </xs:complexType>
                                </xs:element>
                            </xs:sequence>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="Supplements" minOccurs="0">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="Supplement" maxOccurs="unbounded">
                                    <xs:complexType>
                                        <xs:sequence>
                                            <xs:element name="RoomCompanions" minOccurs="0" maxOccurs="5">
                                                <xs:complexType>
                                                    <xs:attributeGroup ref="tns:AgeQualifyingGroup"/>
                                                    <xs:attribute name="MinCompanions" type="xs:nonNegativeInteger"
                                                                  use="optional"/>
                                                    <xs:attribute name="MaxCompanions" type="xs:nonNegativeInteger"
                                                                  use="optional"/>
                                                </xs:complexType>
                                            </xs:element>
                                            <xs:element name="PrerequisiteInventory" minOccurs="0" maxOccurs="5">
                                                <xs:complexType>
                                                    <xs:attribute name="InvCode" type="tns:StringLength1to16"
                                                                  use="optional"/>
                                                    <xs:attribute name="InvType" type="tns:StringLength1to16"
                                                                  use="optional"/>
                                                </xs:complexType>
                                            </xs:element>
                                            <xs:element name="Description" type="tns:ParagraphType" minOccurs="0"
                                                        maxOccurs="5"/>
                                        </xs:sequence>
                                        <xs:attributeGroup ref="tns:AgeQualifyingGroup"/>
                                        <xs:attributeGroup ref="tns:CurrencyAmountGroup"/>
                                        <xs:attributeGroup ref="tns:DateTimeSpanGroup"/>
                                        <xs:attribute name="SupplementType" use="optional">
                                            <xs:simpleType>
                                                <xs:restriction base="xs:NMTOKEN">
                                                    <xs:enumeration value="AdditionalGuest"/>
                                                    <xs:enumeration value="Board"/>
                                                    <xs:enumeration value="Extra"/>
                                                </xs:restriction>
                                            </xs:simpleType>
                                        </xs:attribute>
                                        <xs:attribute name="ChargeTypeCode" type="tns:OTA_CodeType" use="optional"/>
                                        <xs:attribute name="InvCode" type="tns:StringLength1to16" use="optional"/>
                                        <xs:attribute name="InvType" type="tns:StringLength1to16" use="optional"/>
                                        <xs:attribute name="AdditionalGuestNumber" type="tns:Numeric1to99"
                                                      use="optional"/>
                                        <xs:attribute name="RPH" type="tns:RPH_Type" use="optional"/>
                                        <xs:attribute name="Percent" type="xs:decimal" use="optional"/>
                                        <xs:attribute name="AddToBasicRateIndicator" type="xs:boolean" use="optional"/>
                                        <xs:attribute name="SingleUseIndicator" type="xs:boolean" use="optional"/>
                                        <xs:attribute name="MandatoryIndicator" type="xs:boolean" use="optional"/>
                                    </xs:complexType>
                                </xs:element>
                            </xs:sequence>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="Offers" minOccurs="0">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="Offer" maxOccurs="99">
                                    <xs:complexType>
                                        <xs:complexContent>
                                            <xs:extension base="tns:OfferType">
                                                <xs:attribute name="SupplementRPH" type="tns:ListOfRPH" use="optional"/>
                                            </xs:extension>
                                        </xs:complexContent>
                                    </xs:complexType>
                                </xs:element>
                            </xs:sequence>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="RatePlanShoulders" minOccurs="0">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="RatePlanShoulder" maxOccurs="unbounded">
                                    <xs:complexType>
                                        <xs:sequence>
                                            <xs:element name="SellableProducts" type="tns:SellableProductsType"
                                                        minOccurs="0"/>
                                        </xs:sequence>
                                        <xs:attribute name="ShoulderRPH" type="tns:RPH_Type" use="optional"/>
                                        <xs:attribute name="PreShoulderSellLimit" type="xs:nonNegativeInteger"
                                                      use="optional"/>
                                        <xs:attribute name="PostShoulderSellLimit" type="xs:nonNegativeInteger"
                                                      use="optional"/>
                                        <xs:attribute name="PreShoulderStartDate" type="tns:DateOrDateTimeType"
                                                      use="optional"/>
                                        <xs:attribute name="PostShoulderEndDate" type="tns:DateOrDateTimeType"
                                                      use="optional"/>
                                    </xs:complexType>
                                </xs:element>
                            </xs:sequence>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="SellableProducts" type="tns:SellableProductsType" minOccurs="0"/>
                    <xs:element name="RatePlanLevelFee" minOccurs="0">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="Fee" maxOccurs="unbounded">
                                    <xs:complexType>
                                        <xs:complexContent>
                                            <xs:extension base="tns:FeeType">
                                                <xs:attribute name="MealPlanCode" type="tns:OTA_CodeType"
                                                              use="optional"/>
                                            </xs:extension>
                                        </xs:complexContent>
                                    </xs:complexType>
                                </xs:element>
                            </xs:sequence>
                            <xs:attributeGroup ref="tns:CodeListGroup"/>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="Commission" type="tns:CommissionType" minOccurs="0"/>
                    <xs:element name="Description" type="tns:ParagraphType" minOccurs="0" maxOccurs="5"/>
                    <xs:element name="UniqueID" type="tns:UniqueID_Type" minOccurs="0"/>
                    <xs:element name="HotelRef" minOccurs="0">
                        <xs:complexType>
                            <xs:attributeGroup ref="tns:HotelReferenceGroup"/>
                        </xs:complexType>
                    </xs:element>
                </xs:sequence>
                <xs:attributeGroup ref="tns:DateTimeSpanGroup"/>
                <xs:attributeGroup ref="tns:CurrencyCodeGroup"/>
                <xs:attributeGroup ref="tns:RatePlanGroup"/>
                <xs:attributeGroup ref="tns:RatePlanCodeTypeGroup"/>
                <xs:attribute name="RatePlanNotifType" use="optional">
                    <xs:simpleType>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="New"/>
                            <xs:enumeration value="Delta"/>
                            <xs:enumeration value="Overlay"/>
                            <xs:enumeration value="Remove"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
                <xs:attribute name="RatePlanStatusType" use="optional">
                    <xs:simpleType>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="Initial"/>
                            <xs:enumeration value="Active"/>
                            <xs:enumeration value="Deactivated"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
                <xs:attribute name="RatePlanNotifScopeType" use="optional">
                    <xs:simpleType>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="RatePlanOnly"/>
                            <xs:enumeration value="RateOnly"/>
                            <xs:enumeration value="RatePlanAndRate"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
                <xs:attribute name="IsCommissionable" type="xs:boolean" use="optional"/>
                <xs:attribute name="RateReturn" type="xs:boolean" use="optional"/>
                <xs:attribute name="YieldableIndicator" type="xs:boolean" use="optional"/>
                <xs:attribute name="MarketCode" type="tns:StringLength1to64" use="optional"/>
                <xs:attribute name="YieldDeltaAmount" type="tns:Money" use="optional"/>
                <xs:attribute name="InventoryAllocatedInd" type="xs:boolean" use="optional"/>
                <xs:attribute name="RestrictedDisplayIndicator" type="xs:boolean" use="optional"/>
                <xs:attribute name="EarliestStartIndicator" type="xs:boolean" use="optional"/>
                <xs:attribute name="LatestEndIndicator" type="xs:boolean" use="optional"/>
                <xs:attribute name="ExtraNightRatePlanCode" type="tns:StringLength1to64" use="optional"/>
                <xs:attributeGroup ref="tns:DerivedRatePlanGroup"/>
                <xs:attribute name="ChargeTypeCode" type="tns:OTA_CodeType" use="optional"/>
            </xs:complexType>
            <xs:complexType name="Hotel">
                <xs:sequence>
                    <xs:element name="code" type="xs:string"/>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="User">
                <xs:sequence>
                    <xs:element name="CustomerCode" type="xs:string"/>
                    <xs:element name="Username" type="xs:string"/>
                    <xs:element name="Password" type="xs:string"/>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="Customer">
                <xs:sequence>
                    <xs:element name="code" type="xs:string"/>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="OTA_HotelRatePlanNotifRQ">
                <xs:complexContent mixed="false">
                    <xs:extension base="tns:OtaRequestMessage">
                        <xs:sequence>
                            <xs:element name="RatePlans" minOccurs="0">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="RatePlan" type="tns:HotelRatePlanType" maxOccurs="unbounded"/>
                                    </xs:sequence>
                                    <xs:attributeGroup ref="tns:HotelReferenceGroup"/>
                                </xs:complexType>
                            </xs:element>
                            <xs:element minOccurs="0" maxOccurs="1" name="POS" type="tns:POS"/>
                            <xs:element minOccurs="0" maxOccurs="1" name="UniqueID" type="tns:UniqueID_Type"/>
                        </xs:sequence>
                    </xs:extension>
                </xs:complexContent>
            </xs:complexType>
            <xs:complexType name="OTA_HotelRatePlanNotifRS">
                <xs:complexContent mixed="false">
                    <xs:extension base="tns:OtaResponseMessage"/>
                </xs:complexContent>
            </xs:complexType>
            <xs:element name="OTA_HotelRatePlanNotifRQ" type="tns:OTA_HotelRatePlanNotifRQ"/>
            <xs:element name="OTA_HotelRatePlanNotifRS" type="tns:OTA_HotelRatePlanNotifRS"/>
            <xs:complexType name="OTA_HotelInvCountNotifRQ">
                <xs:complexContent mixed="false">
                    <xs:extension base="tns:OtaRequestMessage">
                        <xs:sequence>
                            <xs:element minOccurs="0" maxOccurs="1" name="Inventories"
                                        type="tns:Inventories"/>
                            <xs:element minOccurs="0" maxOccurs="1" name="POS" type="tns:POS"/>
                        </xs:sequence>
                    </xs:extension>
                </xs:complexContent>
            </xs:complexType>
            <xs:complexType name="OTA_HotelInvCountNotifRS">
                <xs:complexContent mixed="false">
                    <xs:extension base="tns:OtaResponseMessage"/>
                </xs:complexContent>
            </xs:complexType>
            <xs:element name="OTA_HotelInvCountNotifRQ" type="tns:OTA_HotelInvCountNotifRQ"/>
            <xs:element name="OTA_HotelInvCountNotifRS" type="tns:OTA_HotelInvCountNotifRS"/>
            <xs:complexType name="OTA_HotelAvailNotifRQ">
                <xs:complexContent mixed="false">
                    <xs:extension base="tns:OtaRequestMessage">
                        <xs:sequence>
                            <xs:element name="AvailStatusMessages" minOccurs="0">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="AvailStatusMessage" type="tns:AvailStatusMessageType"
                                                    maxOccurs="unbounded"/>
                                    </xs:sequence>
                                    <xs:attributeGroup ref="tns:HotelReferenceGroup"/>
                                </xs:complexType>
                            </xs:element>
                            <xs:element minOccurs="0" maxOccurs="1" name="POS" type="tns:POS"/>
                        </xs:sequence>
                    </xs:extension>
                </xs:complexContent>
            </xs:complexType>
            <xs:complexType name="OTA_HotelAvailNotifRS">
                <xs:complexContent mixed="false">
                    <xs:extension base="tns:OtaResponseMessage"/>
                </xs:complexContent>
            </xs:complexType>
            <xs:element name="OTA_HotelAvailNotifRQ" type="tns:OTA_HotelAvailNotifRQ"/>
            <xs:element name="OTA_HotelAvailNotifRS" type="tns:OTA_HotelAvailNotifRS"/>
            <xs:complexType name="Pagination">
                <xs:attribute name="Limit" type="xs:integer" use="optional"/>
                <xs:attribute name="Offset" type="xs:integer" use="optional"/>
            </xs:complexType>
            <xs:complexType name="GetInventoriesRequest">
                <xs:attribute name="HotelCode" type="xs:string"/>
                <xs:attribute name="CustomerCode" type="xs:string"/>
                <xs:attribute name="DeliveryDate" type="xs:date"/>
            </xs:complexType>
            <xs:complexType name="GetInventoriesResponse">
                <xs:complexContent mixed="false">
                    <xs:extension base="tns:OtaResponseMessage">
                        <xs:sequence>
                            <xs:element name="OTA_HotelInvCountNotifRQ" type="tns:OTA_HotelInvCountNotifRQ"
                                        minOccurs="0" maxOccurs="unbounded"/>
                        </xs:sequence>
                    </xs:extension>
                </xs:complexContent>
            </xs:complexType>
            <xs:element name="GetInventoriesRequest" type="tns:GetInventoriesRequest"/>
            <xs:element name="GetInventoriesResponse" type="tns:GetInventoriesResponse"/>

            <xs:complexType name="GetCurrentInventoriesRequest">
                <xs:attribute name="HotelCode" type="xs:string"/>
                <xs:attribute name="CustomerCode" type="xs:string"/>
                <xs:attribute name="DeliveryDate" type="xs:date"/>
            </xs:complexType>
            <xs:complexType name="GetCurrentInventoriesResponse">
                <xs:complexContent mixed="false">
                    <xs:extension base="tns:OtaResponseMessage">
                        <xs:sequence>
                            <xs:element name="OTA_HotelInvCountNotifRQ" type="tns:OTA_HotelInvCountNotifRQ"
                                        minOccurs="0" maxOccurs="unbounded"/>
                        </xs:sequence>
                    </xs:extension>
                </xs:complexContent>
            </xs:complexType>
            <xs:element name="GetCurrentInventoriesRequest" type="tns:GetCurrentInventoriesRequest"/>
            <xs:element name="GetCurrentInventoriesResponse" type="tns:GetCurrentInventoriesResponse"/>

            <xs:complexType name="GetAvailabilitiesRequest">
                <xs:attribute name="HotelCode" type="xs:string"/>
                <xs:attribute name="CustomerCode" type="xs:string"/>
                <xs:attribute name="DeliveryDate" type="xs:date"/>
            </xs:complexType>
            <xs:complexType name="GetAvailabilitiesResponse">
                <xs:complexContent mixed="false">
                    <xs:extension base="tns:OtaResponseMessage">
                        <xs:sequence>
                            <xs:element name="OTA_HotelAvailNotifRQ" type="tns:OTA_HotelAvailNotifRQ" minOccurs="0"
                                        maxOccurs="unbounded"/>
                        </xs:sequence>
                    </xs:extension>
                </xs:complexContent>
            </xs:complexType>
            <xs:element name="GetAvailabilitiesRequest" type="tns:GetAvailabilitiesRequest"/>
            <xs:element name="GetAvailabilitiesResponse" type="tns:GetAvailabilitiesResponse"/>

            <xs:complexType name="GetHotelsByCustomerRequest">
                <xs:sequence>
                    <xs:element name="Customer" type="tns:Customer" minOccurs="1"/>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="GetHotelsByCustomerResponse">
                <xs:complexContent mixed="false">
                    <xs:extension base="tns:OtaResponseMessage">
                        <xs:sequence>
                            <xs:element name="Hotel" type="tns:Hotel" maxOccurs="unbounded"/>
                        </xs:sequence>
                    </xs:extension>
                </xs:complexContent>
            </xs:complexType>
            <xs:element name="GetHotelsByCustomerRequest" type="tns:GetHotelsByCustomerRequest"/>
            <xs:element name="GetHotelsByCustomerResponse" type="tns:GetHotelsByCustomerResponse"/>

            <xs:complexType name="DataFetch">
                <xs:sequence>
                    <xs:element name="Pagination" type="tns:Pagination"/>
                </xs:sequence>
                <xs:attribute name="HotelCode" type="xs:string"/>
                <xs:attribute name="CustomerCode" type="xs:string"/>
            </xs:complexType>
            <xs:complexType name="GetRatesResponse">
                <xs:complexContent mixed="false">
                    <xs:extension base="tns:OtaResponseMessage">
                        <xs:sequence>
                            <xs:element name="OTA_HotelRatePlanNotifRS" type="tns:OTA_HotelRatePlanNotifRS"
                                        minOccurs="0" maxOccurs="unbounded"/>
                        </xs:sequence>
                    </xs:extension>
                </xs:complexContent>
            </xs:complexType>
            <xs:element name="DataFetch" type="tns:DataFetch"/>
            <xs:element name="GetRatesResponse" type="tns:GetRatesResponse"/>

            <xs:complexType name="CreateUserRequest">
                <xs:sequence>
                    <xs:element name="User" type="tns:User" minOccurs="1" maxOccurs="1"/>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="CreateUserResponse">
                <xs:complexContent mixed="false">
                    <xs:extension base="tns:OtaResponseMessage"/>
                </xs:complexContent>
            </xs:complexType>
            <xs:element name="CreateUserRequest" type="tns:CreateUserRequest"/>
            <xs:element name="CreateUserResponse" type="tns:CreateUserResponse"/>

        </xs:schema>
        <xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
                   xmlns:tns="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd"
                   elementFormDefault="qualified"
                   targetNamespace="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd">
            <xs:element name="Security" type="tns:Security"/>
            <xs:complexType name="Security">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="1" name="UsernameToken" type="tns:UsernameToken"/>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType name="UsernameToken">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="1" name="Username" type="xs:string"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="Password" type="xs:string"/>
                </xs:sequence>
            </xs:complexType>
        </xs:schema>
        <xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"  xmlns:tns="http://www.w3.org/2005/08/addressing"
                   elementFormDefault="qualified" targetNamespace="http://www.w3.org/2005/08/addressing">
            <xs:element name="ReplyTo" type="tns:ReplyTo"/>
            <xs:complexType name="ReplyTo">
                <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="1" name="Address" type="xs:string"/>
                </xs:sequence>
            </xs:complexType>
            <xs:element name="Action" type="xs:string"/>
            <xs:element name="MessageID" type="xs:string"/>
            <xs:element name="To" type="xs:string"/>
        </xs:schema>
    </wsdl:types>
    <wsdl:message name="GetInventoriesRequest">
        <wsdl:part xmlns:q51="http://www.opentravel.org/OTA/2003/05" name="GetInventoriesRequest"
                   element="q51:GetInventoriesRequest"/>
    </wsdl:message>
    <wsdl:message name="GetInventoriesRequest_Headers">
        <wsdl:part xmlns:wss="http://www.w3.org/2005/08/addressing" name="To" element="wss:To"/>
        <wsdl:part xmlns:wss="http://www.w3.org/2005/08/addressing" name="MessageID" element="wss:MessageID"/>
        <wsdl:part xmlns:wss="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd"
                   name="Security" element="wss:Security"/>
        <wsdl:part xmlns:wss="http://www.w3.org/2005/08/addressing" name="ReplyTo" element="wss:ReplyTo"/>
        <wsdl:part xmlns:wss="http://www.w3.org/2005/08/addressing" name="Action" element="wss:Action"/>
    </wsdl:message>
    <wsdl:message name="GetInventoriesResponse">
        <wsdl:part xmlns:q53="http://www.opentravel.org/OTA/2003/05" name="GetInventoriesResponse"
                   element="q53:GetInventoriesResponse"/>
    </wsdl:message>

    <wsdl:message name="GetCurrentInventoriesRequest">
        <wsdl:part xmlns:q201="http://www.opentravel.org/OTA/2003/05" name="GetCurrentInventoriesRequest"
                   element="q201:GetCurrentInventoriesRequest"/>
    </wsdl:message>
    <wsdl:message name="GetCurrentInventoriesRequest_Headers">
        <wsdl:part xmlns:wss="http://www.w3.org/2005/08/addressing" name="To" element="wss:To"/>
        <wsdl:part xmlns:wss="http://www.w3.org/2005/08/addressing" name="MessageID" element="wss:MessageID"/>
        <wsdl:part xmlns:wss="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd"
                   name="Security" element="wss:Security"/>
        <wsdl:part xmlns:wss="http://www.w3.org/2005/08/addressing" name="ReplyTo" element="wss:ReplyTo"/>
        <wsdl:part xmlns:wss="http://www.w3.org/2005/08/addressing" name="Action" element="wss:Action"/>
    </wsdl:message>
    <wsdl:message name="GetCurrentInventoriesResponse">
        <wsdl:part xmlns:q202="http://www.opentravel.org/OTA/2003/05" name="GetCurrentInventoriesResponse"
                   element="q202:GetCurrentInventoriesResponse"/>
    </wsdl:message>

    <wsdl:message name="GetAvailabilitiesRequest">
        <wsdl:part xmlns:q41="http://www.opentravel.org/OTA/2003/05" name="GetAvailabilitiesRequest"
                   element="q41:GetAvailabilitiesRequest"/>
    </wsdl:message>
    <wsdl:message name="GetAvailabilitiesRequest_Headers">
        <wsdl:part xmlns:wss="http://www.w3.org/2005/08/addressing" name="To" element="wss:To"/>
        <wsdl:part xmlns:wss="http://www.w3.org/2005/08/addressing" name="MessageID" element="wss:MessageID"/>
        <wsdl:part xmlns:wss="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd"
                   name="Security" element="wss:Security"/>
        <wsdl:part xmlns:wss="http://www.w3.org/2005/08/addressing" name="ReplyTo" element="wss:ReplyTo"/>
        <wsdl:part xmlns:wss="http://www.w3.org/2005/08/addressing" name="Action" element="wss:Action"/>
    </wsdl:message>
    <wsdl:message name="GetAvailabilitiesResponse">
        <wsdl:part xmlns:q43="http://www.opentravel.org/OTA/2003/05" name="GetAvailabilitiesResponse"
                   element="q43:GetAvailabilitiesResponse"/>
    </wsdl:message>

    <wsdl:message name="DataFetch">
        <wsdl:part xmlns:q11="http://www.opentravel.org/OTA/2003/05" name="DataFetch"
                   element="q11:DataFetch"/>
    </wsdl:message>
    <wsdl:message name="GetRatesRequest_Headers">
        <wsdl:part xmlns:wss="http://www.w3.org/2005/08/addressing" name="To" element="wss:To"/>
        <wsdl:part xmlns:wss="http://www.w3.org/2005/08/addressing" name="MessageID" element="wss:MessageID"/>
        <wsdl:part xmlns:wss="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd"
                   name="Security" element="wss:Security"/>
        <wsdl:part xmlns:wss="http://www.w3.org/2005/08/addressing" name="ReplyTo" element="wss:ReplyTo"/>
        <wsdl:part xmlns:wss="http://www.w3.org/2005/08/addressing" name="Action" element="wss:Action"/>
    </wsdl:message>
    <wsdl:message name="GetRatesResponse">
        <wsdl:part xmlns:q13="http://www.opentravel.org/OTA/2003/05" name="GetRatesResponse"
                   element="q13:GetRatesResponse"/>
    </wsdl:message>

    <wsdl:message name="GetHotelsByCustomerRequest">
        <wsdl:part xmlns:q31="http://www.opentravel.org/OTA/2003/05" name="GetHotelsByCustomerRequest"
                   element="q31:GetHotelsByCustomerRequest"/>
    </wsdl:message>
    <wsdl:message name="GetHotelsByCustomerRequest_Headers">
        <wsdl:part xmlns:wss="http://www.w3.org/2005/08/addressing" name="To" element="wss:To"/>
        <wsdl:part xmlns:wss="http://www.w3.org/2005/08/addressing" name="MessageID" element="wss:MessageID"/>
        <wsdl:part xmlns:wss="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd"
                   name="Security" element="wss:Security"/>
        <wsdl:part xmlns:wss="http://www.w3.org/2005/08/addressing" name="ReplyTo" element="wss:ReplyTo"/>
        <wsdl:part xmlns:wss="http://www.w3.org/2005/08/addressing" name="Action" element="wss:Action"/>
    </wsdl:message>
    <wsdl:message name="GetHotelsByCustomerResponse">
        <wsdl:part xmlns:q33="http://www.opentravel.org/OTA/2003/05" name="GetHotelsByCustomerResponse"
                   element="q33:GetHotelsByCustomerResponse"/>
    </wsdl:message>

    <wsdl:message name="CreateUserRequest">
        <wsdl:part xmlns:q101="http://www.opentravel.org/OTA/2003/05" name="CreateUserRequest"
                   element="q101:CreateUserRequest"/>
    </wsdl:message>
    <wsdl:message name="CreateUserRequest_Headers">
        <wsdl:part xmlns:wss="http://www.w3.org/2005/08/addressing" name="To" element="wss:To"/>
        <wsdl:part xmlns:wss="http://www.w3.org/2005/08/addressing" name="MessageID" element="wss:MessageID"/>
        <wsdl:part xmlns:wss="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd"
                   name="Security" element="wss:Security"/>
        <wsdl:part xmlns:wss="http://www.w3.org/2005/08/addressing" name="ReplyTo" element="wss:ReplyTo"/>
        <wsdl:part xmlns:wss="http://www.w3.org/2005/08/addressing" name="Action" element="wss:Action"/>
    </wsdl:message>
    <wsdl:message name="CreateUserResponse">
        <wsdl:part xmlns:q102="http://www.opentravel.org/OTA/2003/05" name="CreateUserResponse"
                   element="q102:CreateUserResponse"/>
    </wsdl:message>

    <wsdl:portType name="serviceSoap">
        <wsdl:operation name="GetInventories">
            <wsdl:input message="tns:DataFetch"/>
            <wsdl:output message="tns:GetInventoriesResponse"/>
        </wsdl:operation>
        <wsdl:operation name="GetCurrentInventories">
            <wsdl:input message="tns:GetCurrentInventoriesRequest"/>
            <wsdl:output message="tns:GetCurrentInventoriesResponse"/>
        </wsdl:operation>
        <wsdl:operation name="GetAvailabilities">
            <wsdl:input message="tns:DataFetch"/>
            <wsdl:output message="tns:GetAvailabilitiesResponse"/>
        </wsdl:operation>
        <wsdl:operation name="GetRates">
            <wsdl:input message="tns:DataFetch"/>
            <wsdl:output message="tns:GetRatesResponse"/>
        </wsdl:operation>
        <wsdl:operation name="GetHotelsByCustomer">
            <wsdl:input message="tns:GetHotelsByCustomerRequest"/>
            <wsdl:output message="tns:GetHotelsByCustomerResponse"/>
        </wsdl:operation>
        <wsdl:operation name="CreateUser">
            <wsdl:input message="tns:CreateUserRequest"/>
            <wsdl:output message="tns:CreateUserResponse"/>
        </wsdl:operation>
    </wsdl:portType>

    <wsdl:binding name="GetRatesAction" type="tns:serviceSoap">
        <soap:binding transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="GetRates">
            <soap:operation soapAction="<%= base_url %>/soap/getRates" style="document"/>
            <wsdl:input name="GetRatesRequest">
                <soap:header message="tns:GetRatesRequest_Headers" part="Security" use="literal"/>
                <soap:body use="literal"/>
            </wsdl:input>
            <wsdl:output name="GetRatesResponse">
                <soap:body use="literal"/>
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>

    <wsdl:binding name="GetInventoriesAction" type="tns:serviceSoap">
        <soap:binding transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="GetInventories">
            <soap:operation soapAction="<%= base_url %>/soap/getInventories" style="document"/>
            <wsdl:input name="GetInventoriesRequest">
                <soap:header message="tns:GetInventoriesRequest_Headers" part="Security" use="literal"/>
                <soap:body use="literal"/>
            </wsdl:input>
            <wsdl:output name="GetInventoriesResponse">
                <soap:body use="literal"/>
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>

    <wsdl:binding name="GetAvailabilitiesAction" type="tns:serviceSoap">
        <soap:binding transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="GetAvailabilities">
            <soap:operation soapAction="<%= base_url %>/soap/getInventories" style="document"/>
            <wsdl:input name="GetAvailabilitiesRequest">
                <soap:header message="tns:GetInventoriesRequest_Headers" part="Security" use="literal"/>
                <soap:body use="literal"/>
            </wsdl:input>
            <wsdl:output name="GetAvailabilitiesResponse">
                <soap:body use="literal"/>
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>

    <wsdl:service name="OtaAriPushPrivate">
        <wsdl:port name="GetRatesPort" binding="tns:GetRatesAction">
            <soap:address location="<%= base_url %>/soap/getRates"/>
        </wsdl:port>
        <wsdl:port name="GetInventoriesPort" binding="tns:GetInventoriesAction">
            <soap:address location="<%= base_url %>/soap/getInventories"/>
        </wsdl:port>
        <wsdl:port name="GetAvailabilitiesPort" binding="tns:GetAvailabilitiesAction">
            <soap:address location="<%= base_url %>/soap/getAvailabilities"/>
        </wsdl:port>
    </wsdl:service>

</wsdl:definitions>