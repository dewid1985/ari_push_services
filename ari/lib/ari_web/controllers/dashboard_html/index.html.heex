<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css">

<style>
  body { margin-top: 20px; background: #eee; }
  table.dataTable td { font-size: 11px; text-align: center; }
  table.dataTable thead th, table.dataTable tfoot th { font-size: 0.7rem; text-align: center; }
  table.dataTable tbody td { padding: 5px; vertical-align: middle; }
  .card-body-ari { border-radius: 0; }
  .filter-header { font-size: 0.8rem; margin-top: 0.8rem; margin-bottom: 0.2rem; }
  .form-label { font-size: 0.7rem; line-height: 1.2; margin-bottom: 0.2rem; }
  .filter-label { font-size: 0.8rem; margin-top: 0.2rem; margin-bottom: 0.2rem; font-weight: 500; line-height: 1.2; }
  .nav-tabs { border-bottom: 0; }
  .nav-link { display: block; padding: 0.3rem 0.6rem; }
  .nav-tabs .nav-link { border-top-left-radius: 0; border-top-right-radius: 0; }
  .bg-dark { background-color: #212529 !important; padding-top: 0.1rem; padding-bottom: 0.1rem; }
  .text-left { text-align: left !important; }
  .text-center { text-align: center !important; vertical-align: middle !important; }
  .value { font-weight: bold; }
  .value.badge { font-size: 1em; margin-top: 2px; background-color: #d9d9d996 !important; color: #212529; }
  .list { padding: 0.3rem 0; }
  .btn-table { padding: 0.13rem 0.26rem; font-size: .75rem; }
  .dataTables_wrapper .dataTables_length select { min-height: calc(1.5em + (0.5rem + 2px)); padding: 0.4rem 0.2rem; font-size: .8rem; border-radius: 0; margin-bottom: 0.1rem; }
  .dataTables_wrapper .dataTables_length, .dataTables_wrapper .dataTables_filter, .dataTables_wrapper .dataTables_info, .dataTables_wrapper .dataTables_processing, .dataTables_wrapper .dataTables_paginate { color: inherit; font-size: 0.7rem; }
</style>

<nav class="navbar navbar-dark bg-dark fixed-top">
  <div class="container-fluid">
    <a class="navbar-brand" href={~p"/dashboard"}>Push ARI Service</a>
    <div class="d-flex justify-content-end">
      <a href="#messages" class="btn btn-dark me-2 active" data-bs-toggle="tab" data-bs-target="#tab-messages">
        <i class="fas fa-envelope me-2"></i> OTA Messages
      </a>
      <a href="#users" class="btn btn-dark" data-bs-toggle="tab" data-bs-target="#tab-users">
        <i class="fas fa-users me-2"></i> Users
      </a>
    </div>
  </div>
</nav>

<div class="container-fluid" style="margin-top: 3rem">
  <main>
    <ul class="nav nav-tabs" role="tablist">
      <li class="nav-item">
        <a href="#tab-messages" class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-messages" role="tab">
          <i class="fas fa-comments"></i> Messages
        </a>
      </li>
      <li class="nav-item">
        <a href="#tab-users" class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-users" role="tab">
          <i class="fas fa-users"></i> Users
        </a>
      </li>
    </ul>

    <div class="tab-content">
      <div class="tab-pane fade show active" id="tab-messages" role="tabpanel">
        <div class="card card-body-ari">
          <div class="card-body">
            <div class="row">
              <div class="col-md-2" id="filter-container">
                <h6 class="grid-title"><i class="fa fa-search"></i> Filters</h6>
                <form id="filter">
                  <label for="hotelCode" class="form-label filter-label">Hotel Code:</label>
                  <input type="text" class="form-control form-control-sm" id="hotelCode">

                  <label for="type" class="form-label filter-label">Request Type:</label>
                  <select class="form-control form-control-sm" id="type">
                    <option value="">Choose...</option>
                    <option value="rate">OTA_HotelRatePlanNotifRQ</option>
                    <option value="availability">OTA_HotelAvailNotifRQ</option>
                    <option value="inventory">OTA_HotelInvCountNotifRQ</option>
                  </select>

                  <label for="checksum" class="form-label filter-label">Checksum:</label>
                  <input type="text" class="form-control form-control-sm" id="checksum">

                  <label for="userName" class="form-label filter-label">Username:</label>
                  <input type="text" class="form-control form-control-sm" id="userName">

                  <label for="outsideId" class="form-label filter-label">SynXis Request Message ID:</label>
                  <input type="text" class="form-control form-control-sm" id="outsideId">

                  <h6 class="filter-header">SynXis Message Time (GMT)</h6>
                  <label for="startDate" class="form-label">From:</label>
                  <input type="datetime-local" class="form-control form-control-sm" id="startDate" step="1">
                  <label for="endDate" class="form-label">To:</label>
                  <input type="datetime-local" class="form-control form-control-sm" id="endDate" step="1">

                  <label for="internalId" class="form-label filter-label">TraSo Response Message ID:</label>
                  <input type="text" class="form-control form-control-sm" id="internalId">

                  <h6 class="filter-header">TraSo Received Time (Europe/Berlin)</h6>
                  <label for="startCreatedAt" class="form-label">From:</label>
                  <input type="datetime-local" class="form-control form-control-sm" id="startCreatedAt" step="1">
                  <label for="endCreatedAt" class="form-label">To:</label>
                  <input type="datetime-local" class="form-control form-control-sm" id="endCreatedAt" step="1">

                  <h6 class="filter-header">TraSo Response Time (Europe/Berlin)</h6>
                  <label for="startUpdatedAt" class="form-label">From:</label>
                  <input type="datetime-local" class="form-control form-control-sm" id="startUpdatedAt" step="1">
                  <label for="endUpdatedAt" class="form-label">To:</label>
                  <input type="datetime-local" class="form-control form-control-sm" id="endUpdatedAt" step="1">

                  <div class="row mt-2">
                    <div class="col-md-4">
                      <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="double">
                        <label class="form-check-label" for="double">Duplicates</label>
                      </div>
                    </div>
                    <div class="col-md-4">
                      <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="error">
                        <label class="form-check-label" for="error">Errors</label>
                      </div>
                    </div>
                    <div class="col-md-4">
                      <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="active" checked>
                        <label class="form-check-label" for="active">Active</label>
                      </div>
                    </div>
                  </div>

                  <div class="text-end mt-2">
                    <button type="button" class="btn btn-sm btn-danger" id="deactivateMessage">
                      <i class="fas fa-ban"></i> Deactivate
                    </button>
                    <button type="button" class="btn btn-success btn-sm" id="activateMessage">
                      <i class="fas fa-check"></i> Activate
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" id="clear">
                      <i class="fas fa-broom"></i> Clear
                    </button>
                    <button type="button" class="btn btn-dark btn-sm" id="search">
                      <i class="fas fa-search"></i> Search
                    </button>
                  </div>
                </form>
              </div>

              <div class="col-md-10">
                <h6 class="grid-title"><i class="fa fa-list"></i> List</h6>
                <div class="card-body list">
                  <table id="list" class="table table-hover table-light table-sm" style="width:100%">
                    <thead>
                      <tr>
                        <th class="text-left">Message Content</th>
                        <th class="text-left">SynXis Request Message Details</th>
                        <th class="text-left">TraSo Message Processing Details</th>
                        <th class="text-center"></th>
                      </tr>
                    </thead>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="tab-pane fade" id="tab-users" role="tabpanel">
        <div class="card card-body-ari">
          <div class="card-body">
            <div class="row">
              <div class="col-md-2">
                <h6 class="grid-title"><i class="fa fa-search"></i> Filters</h6>
                <form id="user-filter">
                  <label for="filter-name" class="form-label filter-label">Username</label>
                  <input type="text" class="form-control form-control-sm" id="filter-name">
                  <label for="filter-customerCode" class="form-label filter-label">Customer Code</label>
                  <input type="text" class="form-control form-control-sm" id="filter-customerCode">
                  <hr>
                  <div class="text-end">
                    <button type="button" class="btn btn-secondary btn-sm" id="user-clear">
                      <i class="fa fa-broom"></i> Clear
                    </button>
                    <button type="button" class="btn btn-dark btn-sm" id="user-search">
                      <i class="fa fa-search"></i> Search
                    </button>
                  </div>
                </form>
              </div>

              <div class="col-md-10">
                <div class="row">
                  <div class="col">
                    <h6 class="grid-title"><i class="fa fa-list"></i> List</h6>
                  </div>
                  <div class="col text-end">
                    <button class="btn btn-link btn-sm ms-auto alert-link" id="createUser" data-bs-toggle="modal" data-bs-target="#createUserModal">
                      <i class="fas fa-user-plus me-2"></i> Create User
                    </button>
                  </div>
                </div>
                <div class="card-body list">
                  <table id="users-list" class="table table-sm" style="width:100%">
                    <thead>
                      <tr>
                        <th>id</th>
                        <th>Username</th>
                        <th>Customer code</th>
                        <th>Created at</th>
                      </tr>
                    </thead>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<div class="modal fade" id="createUserModal" data-bs-backdrop="static" tabindex="-1" aria-labelledby="createUserModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="createUserModalLabel"><i class="fas fa-user-plus"></i> Create User</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="create-user-form">
          <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input type="email" class="form-control form-control-sm" id="username" required>
            <div id="feedback_username" class="invalid-feedback"></div>
          </div>
          <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <div class="input-group input-group-sm">
              <input type="text" class="form-control form-control-sm" id="password" required>
              <button type="button" class="btn btn-secondary" id="generatePassword"><i class="fas fa-magic"></i></button>
              <button type="button" class="btn btn-primary" id="copyPassword"><i class="fas fa-clone"></i></button>
            </div>
            <div id="feedback_password" class="invalid-feedback"></div>
          </div>
          <div class="mb-3">
            <label for="customerCode" class="form-label">Customer Code</label>
            <input type="text" class="form-control form-control-sm" id="customerCode" required>
            <div id="feedback_customerCode" class="invalid-feedback"></div>
          </div>
          <button type="submit" class="btn btn-primary btn-sm" id="create-users">
            <i class="fas fa-save"></i> Save
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
<script>
  function messageFilters() {
    return {
      hotel_code: $("#hotelCode").val(),
      type: $("#type").val(),
      checksum: $("#checksum").val(),
      user_name: $("#userName").val(),
      outside_id: $("#outsideId").val(),
      internal_id: $("#internalId").val(),
      time_from: $("#startDate").val(),
      time_to: $("#endDate").val(),
      created_from: $("#startCreatedAt").val(),
      created_to: $("#endCreatedAt").val(),
      updated_from: $("#startUpdatedAt").val(),
      updated_to: $("#endUpdatedAt").val(),
      double: $("#double").is(":checked") ? "true" : "",
      error: $("#error").is(":checked") ? "true" : "",
      active: $("#active").is(":checked") ? "true" : ""
    };
  }

  function userFilters() {
    return {
      email: $("#filter-name").val(),
      customer_code: $("#filter-customerCode").val()
    };
  }

  function badge(value, className) {
    return `<span class="badge value ${className || "text-bg-secondary"}">${value || ""}</span>`;
  }

  const messagesTable = $("#list").DataTable({
    ajax: { url: "/dashboard/api/messages", data: messageFilters, dataSrc: "data" },
    pageLength: 25,
    columns: [
      {
        data: null,
        render: function(row) {
          return `
            <div class="text-left">
              <div>Hotel: ${badge(row.hotel_code)}</div>
              <div>Type: ${badge(row.type)}</div>
              <div>Customer: ${badge(row.customer_code)}</div>
              <div>Checksum: <code>${row.checksum || ""}</code></div>
            </div>`;
        }
      },
      {
        data: null,
        render: function(row) {
          return `
            <div class="text-left">
              <div>Message ID: <code>${row.outside_id || ""}</code></div>
              <div>User: ${row.user_name || ""}</div>
              <div>Time: ${row.time_stamp || ""}</div>
            </div>`;
        }
      },
      {
        data: null,
        render: function(row) {
          return `
            <div class="text-left">
              <div>Response ID: <code>${row.internal_id || ""}</code></div>
              <div>Received: ${row.inserted_at || ""}</div>
              <div>Updated: ${row.updated_at || ""}</div>
              <div>${row.error ? badge("error", "text-bg-danger") : badge("ok", "text-bg-success")} ${row.active ? badge("active", "text-bg-success") : badge("inactive", "text-bg-secondary")}</div>
            </div>`;
        }
      },
      {
        data: null,
        orderable: false,
        render: function(row) {
          return `<button class="btn btn-table ${row.active ? "btn-outline-danger" : "btn-outline-success"}" data-message-active="${!row.active}" data-message-id="${row.id}">
            <i class="fas ${row.active ? "fa-ban" : "fa-check"}"></i>
          </button>`;
        }
      }
    ]
  });

  const usersTable = $("#users-list").DataTable({
    ajax: { url: "/dashboard/api/users", data: userFilters, dataSrc: "data" },
    pageLength: 25,
    columns: [
      { data: "id" },
      { data: "email" },
      { data: "customer_code" },
      { data: "inserted_at" }
    ]
  });

  $("#search").on("click", function() { messagesTable.ajax.reload(); });
  $("#clear").on("click", function() {
    $("#filter")[0].reset();
    $("#active").prop("checked", true);
    messagesTable.ajax.reload();
  });

  $("#user-search").on("click", function() { usersTable.ajax.reload(); });
  $("#user-clear").on("click", function() {
    $("#user-filter")[0].reset();
    usersTable.ajax.reload();
  });

  function setMessagesActive(active, extra) {
    $.ajax({
      url: "/dashboard/api/messages/active",
      method: "POST",
      contentType: "application/json",
      data: JSON.stringify(Object.assign(messageFilters(), extra || {}, {active: active})),
      success: function() { messagesTable.ajax.reload(); }
    });
  }

  $("#deactivateMessage").on("click", function() { setMessagesActive(false); });
  $("#activateMessage").on("click", function() { setMessagesActive(true); });

  $("#list").on("click", "[data-message-id]", function() {
    setMessagesActive($(this).data("message-active"), {id: $(this).data("message-id")});
  });

  $("#generatePassword").on("click", function() {
    const password = Math.random().toString(36).slice(2, 10) + Math.random().toString(36).slice(2, 10);
    $("#password").val(password);
  });

  $("#copyPassword").on("click", function() {
    navigator.clipboard.writeText($("#password").val());
  });

  $("#create-user-form").on("submit", function(event) {
    event.preventDefault();
    $.ajax({
      url: "/dashboard/api/users",
      method: "POST",
      contentType: "application/json",
      data: JSON.stringify({
        email: $("#username").val(),
        password: $("#password").val(),
        customer_code: $("#customerCode").val()
      }),
      success: function() {
        $("#createUserModal").modal("hide");
        $("#create-user-form")[0].reset();
        usersTable.ajax.reload();
      },
      error: function(xhr) {
        alert(JSON.stringify(xhr.responseJSON || {error: "Unable to create user"}));
      }
    });
  });
</script>
